@startuml Activity Diagram - Xem lịch sử chat  & Đánh dấu đã đọc 
!theme plain
title Activity Diagram - Xem lịch sử chat  & Đánh dấu đã đọc 

|User|
start
if (Xem lịch sử?) then
    :Xem lịch sử chat;
    |System|
    :Lấy danh sách conversations của user;
    :Lọc theo quyền;
    :Sắp xếp theo lastMessageAt;
    :Phân trang;
    :Trả về danh sách;
elseif (Xem chi tiết conversation?) then
    :Chọn conversation;
    |System|
    :Kiểm tra quyền truy cập;
    :Lấy tin nhắn của conversation;
    :Phân trang;
    :Trả về danh sách tin nhắn;
elseif (Đánh dấu đã đọc?) then
    :Đánh dấu đã đọc;
    :Chọn conversation;
    |System|
    :Cập nhật unreadCount = 0;
    :Cập nhật trạng thái tin nhắn (read);
    :Phát event 'conversation:read';
endif
stop
@enduml
