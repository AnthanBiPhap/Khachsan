@startuml Activity Diagram - Cập nhật trạng thái tự động & Scheduler (UC72, UC72A)
!theme plain
title Activity Diagram - Cập nhật trạng thái tự động & Scheduler (UC72, UC72A)

|System (Scheduler)|
start
:Khởi động scheduler;
:Thiết lập cron jobs;
if (Cập nhật trạng thái tự động?) then
    :Cập nhật trạng thái tự động;
    :Chạy scheduled job mỗi phút;
    :Lấy bookings với status đang chờ xử lý;
    if (Giữ chỗ hết hạn?) then (có)
        :Cập nhật status = expired;
        :Giải phóng phòng;
        :Gửi email thông báo hết hạn;
    endif
    if (No-show?) then (có)
        :Cập nhật status = no_show;
        :Giải phóng phòng;
        :Gửi email thông báo no-show;
    endif
    if (Checkout quá hạn?) then (có)
        :Cập nhật status = overdue_checkout;
        :Tính phí phụ thu;
    endif
elseif (Cleanup tasks?) then
    :Lên lịch tác vụ;
    if (Cleanup OTP hết hạn?) then
        :Tìm OTP với expiredAt < now;
        :Xóa OTP hết hạn;
    endif
    if (Cleanup tokens?) then
        :Tìm verification tokens hết hạn;
        :Xóa tokens hết hạn;
    endif
    if (Cleanup logs?) then
        :Tìm logs cũ hơn 90 ngày;
        :Archive hoặc xóa logs;
    endif
endif
stop
@enduml
