@startuml Activity Diagram - Thanh toán tiền mặt/chuyển khoản (UC30, UC31)
!theme plain
title Activity Diagram - Thanh toán tiền mặt/chuyển khoản (UC30, UC31)

|Staff/Admin|
start
if (Thanh toán tiền mặt?) then
    :Thanh toán tiền mặt;
    :Chọn booking;
    :Nhập số tiền;
    :Xác nhận thanh toán;
    |System|
    :Tạo payment record (method = cash, status = paid);
    :Cập nhật booking payment status;
    :Tạo invoice nếu chưa có;
    |System|
    :Gửi email xác nhận;
    :Gửi hóa đơn;
elseif (Thanh toán chuyển khoản?) then
    :Thanh toán chuyển khoản;
    :Chọn booking;
    :Nhập mã tham chiếu giao dịch;
    :Nhập số tiền;
    :Xác nhận;
    |System|
    :Tạo payment record (method = transfer, status = pending);
    :Lưu mã tham chiếu;
    :Cập nhật booking payment status;
    :Ghi audit log;
    :Chờ xác nhận thanh toán;
endif
stop
@enduml
