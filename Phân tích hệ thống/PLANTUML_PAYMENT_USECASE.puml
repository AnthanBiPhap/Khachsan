@startuml Payment & Invoice - Use Case Diagram
!theme plain
skinparam backgroundColor #FFFFFF
skinparam usecase {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
    FontSize 11
}
skinparam actor {
    BackgroundColor #FFF3E0
    BorderColor #E65100
    FontSize 12
    FontStyle bold
}
skinparam rectangle {
    BackgroundColor #F5F5F5
    BorderColor #757575
}

title Payment & Invoice - Use Case Diagram\nHệ thống Miko Hotel

' ========== ACTORS ==========
actor "Customer\nKhách hàng" as Customer
actor "Staff\nNhân viên" as Staff
actor "Admin\nQuản trị viên" as Admin
actor "System\nHệ thống" as System

' ========== PAYMENT & INVOICE USE CASES ==========
rectangle "Payment & Invoice" {
    usecase "UC29: Thanh toán online (Stripe)" as UC29
    usecase "UC30: Thanh toán tiền mặt" as UC30
    usecase "UC31: Thanh toán chuyển khoản" as UC31
    usecase "UC32: Xem lịch sử thanh toán" as UC32
    usecase "UC33: Quản lý thanh toán" as UC33
    usecase "UC33B: Cập nhật trạng thái payment" as UC33B
    usecase "UC33C: Thống kê thanh toán" as UC33C
    usecase "UC33D: Đồng bộ payment với booking" as UC33D
    usecase "UC33E: Xem payment theo booking/khách" as UC33E
    usecase "UC34: Xử lý hoàn tiền" as UC34
    usecase "UC35: Xuất hóa đơn PDF" as UC35
    usecase "UC35A: Gửi hóa đơn qua email" as UC35A
    usecase "UC36: Tạo hóa đơn" as UC36
    usecase "UC37: Xem hóa đơn" as UC37
}

' ========== CUSTOMER CONNECTIONS ==========
Customer --> UC29 : "Thanh toán online"
Customer --> UC32 : "Xem lịch sử thanh toán"
Customer --> UC35 : "Xuất hóa đơn PDF"
Customer --> UC37 : "Xem hóa đơn"

' ========== STAFF CONNECTIONS ==========
Staff --> UC30 : "Thanh toán tiền mặt"
Staff --> UC31 : "Thanh toán chuyển khoản"
Staff --> UC33 : "Quản lý thanh toán"
Staff --> UC33B : "Cập nhật trạng thái"
Staff --> UC33C : "Thống kê thanh toán"
Staff --> UC33D : "Đồng bộ payment"
Staff --> UC33E : "Xem payment theo booking/khách"
Staff --> UC36 : "Tạo hóa đơn"
Staff --> UC37 : "Xem hóa đơn"

' ========== ADMIN CONNECTIONS ==========
Admin --> UC30 : "Thanh toán tiền mặt"
Admin --> UC31 : "Thanh toán chuyển khoản"
Admin --> UC33 : "Quản lý thanh toán"
Admin --> UC33B : "Cập nhật trạng thái"
Admin --> UC33C : "Thống kê thanh toán"
Admin --> UC33D : "Đồng bộ payment"
Admin --> UC33E : "Xem payment theo booking/khách"
Admin --> UC34 : "Xử lý hoàn tiền"
Admin --> UC35A : "Gửi hóa đơn email"
Admin --> UC36 : "Tạo hóa đơn"
Admin --> UC37 : "Xem hóa đơn"

' ========== SYSTEM CONNECTIONS ==========
System --> UC35A : "Gửi hóa đơn email"
System --> UC71 : "Stripe webhook"

' ========== INCLUDES/EXTENDS RELATIONSHIPS ==========
UC29 ..> UC71 : <<include>>\n"Xử lý thanh toán Stripe"
UC35 ..> UC36 : <<include>>\n"Tạo hóa đơn trước"
UC35A ..> UC36 : <<include>>\n"Tạo hóa đơn trước"
UC33D ..> UC33 : <<extend>>\n"Đồng bộ từ quản lý"
UC33E ..> UC33 : <<extend>>\n"Xem chi tiết"

note right of UC29
  Tạo phiên Stripe Checkout
  Thanh toán thẻ tín dụng/ghi nợ
  Nhận kết quả và cập nhật:
  - Booking status
  - Payment status
end note

note right of UC30
  Ghi nhận giao dịch tiền mặt
  Cập nhật trạng thái:
  - Payment status
  - Invoice status
end note

note right of UC31
  Ghi nhận giao dịch chuyển khoản:
  - Mã tham chiếu
  - Thông tin ngân hàng
  Cập nhật trạng thái payment/invoice
end note

note right of UC32
  Xem lịch sử payments của chính mình:
  - Đặt phòng cá nhân
  - Đặt phòng nhóm
  - Trạng thái thanh toán
end note

note right of UC33
  Tra cứu, xem chi tiết payment
  Lọc theo:
  - Booking
  - Khách hàng
  - Trạng thái
  - Thời gian
end note

note right of UC33B
  Đánh dấu trạng thái:
  - paid
  - failed
  - refunded
  - cancelled
  Ghi audit cho staff
  Phát notify nếu cần
end note

note right of UC33C
  Xem thống kê tổng hợp:
  - Doanh thu
  - Số giao dịch theo trạng thái
  - Số giao dịch theo thời gian
end note

note right of UC33D
  Chạy đồng bộ payment ↔ booking
  Đảm bảo trạng thái nhất quán
  Xử lý các trường hợp không đồng bộ
end note

note right of UC34
  Thực hiện refund theo chính sách
  Sau khi duyệt hủy
  Cập nhật:
  - Payment status
  - Invoice status
end note

note right of UC35
  Tạo và xem/tải hóa đơn PDF
  Theo booking
  Bao gồm đầy đủ thông tin
end note

note right of UC35A
  Gửi file/invoice link đến email khách
  Sau khi thanh toán hoặc khi yêu cầu
  Kèm PDF đính kèm
end note

note right of UC36
  Sinh invoice từ:
  - Booking
  - Đặt đoàn
  Thêm dòng chi phí/dịch vụ
  Chốt hóa đơn
end note

note right of UC37
  Xem danh sách/chi tiết invoice
  Theo quyền truy cập
  Không cho sửa sau khi "completed"
end note

@enduml

