@startuml Algorithm - Gợi ý phản hồi chat
!theme plain
title Sơ đồ thuật toán - Gợi ý phản hồi chat

start
:Input: conversationId, messageContent, userId (Staff);
:Kiểm tra quyền Staff/Admin;
:Phân tích nội dung tin nhắn;
:Tìm kiếm trong knowledge base (FAQ, policies, guides);
:So khớp với các mẫu câu trả lời;
:Tạo gợi ý phản hồi;
if (Có context booking?) then (Có)
 :Thêm thông tin booking vào gợi ý;
endif
if (Cần báo giá?) then (Có)
 :Tạo gợi ý báo giá cơ bản;
endif
:Return danh sách gợi ý phản hồi;
note right: Staff có thể chỉnh sửa\ntrước khi gửi
stop
@enduml

