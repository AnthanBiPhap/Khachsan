@startuml Algorithm - Nhận thông báo real-time
!theme plain
title Sơ đồ thuật toán - Nhận thông báo real-time

start
:Input: socket connection, userId;
:Xác thực JWT token;
:Join Socket.IO room theo userId;
:Listen event 'message:new';
if (Nhận event 'message:new'?) then (Có)
 :Kiểm tra conversationId khớp?;
 if (Đang mở conversation?) then (Có)
 :Hiển thị tin nhắn ngay;
 :Tự động đánh dấu đã đọc;
 else
 :Tăng unreadCount;
 :Cập nhật badge;
 endif
endif
if (Mất kết nối?) then (Có)
 :Kích hoạt polling fallback;
 :Poll API mỗi 5-10 giây;
endif
stop
@enduml

