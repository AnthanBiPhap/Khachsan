@startuml Activity Diagram - Hủy đặt phòng  & Duyệt hủy 
!theme plain
title Activity Diagram - Hủy đặt phòng  & Duyệt hủy 

|Customer|
start
if (Hủy đặt phòng?) then
    :Hủy đặt phòng;
    :Nhập lý do hủy;
    |System|
    :Kiểm tra chính sách hủy;
    :Tạo yêu cầu hủy (status = cancellation_requested);
    |System|
    :Gửi email xác nhận yêu cầu hủy;
    :Gửi thông báo realtime;
endif
|Staff/Admin|
if (Duyệt hủy?) then
    :Duyệt hủy đặt phòng;
    :Xem yêu cầu hủy;
    :Kiểm tra chính sách hủy;
    if (Phê duyệt hủy?) then (có)
        :Phê duyệt hủy;
        |System|
        :Cập nhật status = cancelled;
        :Hoàn tiền (nếu có);
        :Giải phóng phòng;
        |System|
        :Gửi email xác nhận hủy;
    else
        :Từ chối hủy;
        |System|
        :Cập nhật status = confirmed;
        |System|
        :Gửi email thông báo;
    endif
endif
stop
@enduml
