@startuml Activity Diagram - Xem danh sách và chi tiết khách (UC28A, UC28B)
!theme plain
title Activity Diagram - Xem danh sách và chi tiết khách (UC28A, UC28B)

|Staff/Admin|
start
if (Xem danh sách?) then
    :Xem danh sách khách;
    :Nhập tiêu chí tìm kiếm/lọc (tên/email/SĐT);
    |System|
    :Lấy danh sách guests từ database;
    :Áp dụng bộ lọc;
    :Sắp xếp theo createdAt DESC;
    :Phân trang;
    :Trả về danh sách;
elseif (Xem chi tiết?) then
    :Xem chi tiết khách;
    :Chọn guest;
    |System|
    :Lấy chi tiết guest;
    :Lấy hồ sơ, thông tin liên hệ, ghi chú;
    :Trả về chi tiết;
endif
stop
@enduml
