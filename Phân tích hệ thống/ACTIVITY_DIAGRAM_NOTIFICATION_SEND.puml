@startuml Activity Diagram - Gửi thông báo (UC56, UC56A)
!theme plain
title Activity Diagram - Gửi thông báo (UC56, UC56A)

|Staff/Admin|
start
if (Gửi thủ công?) then
    :Gửi thông báo thủ công;
    :Chọn người nhận (user/role/channel);
    :Điền thông tin thông báo;
    :Chọn kênh gửi (in-app/email);
    :Xác nhận gửi;
    |System|
    :Xác định danh sách người nhận;
    :Tạo notification record cho mỗi user;
    :Lưu vào database;
    :Phát event 'notification:new' qua Socket.IO;
    :Gửi email (nếu kênh email enabled);
elseif (Gửi tự động?) then
    |System|
    :Gửi thông báo hệ thống;
    :Trigger: Có sự kiện (booking, payment, etc.);
    :Tìm template theo event type;
    :Render content từ template;
    :Xác định recipients từ context;
    :Tạo notification record;
    :Phát event 'notification:new';
    :Gửi email (nếu enabled);
endif
stop
@enduml
