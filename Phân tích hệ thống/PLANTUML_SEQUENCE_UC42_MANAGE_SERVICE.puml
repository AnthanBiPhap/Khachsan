@startuml UC42_ManageService
!theme plain
title UC42: Quản lý dịch vụ (catalog)

actor Admin
participant "Admin Frontend" as Frontend
participant "Backend API" as API
database "Database" as DB

' ========== CREATE SERVICE ==========
Admin -> Frontend: Tạo dịch vụ mới
Frontend -> API: POST /api/v1/services\n(Authorization: Bearer token)\n{ name, description, basePrice, category, unit, schedule }

API -> API: Verify JWT + Check role = admin
API -> DB: Tạo service mới\n(isActive: true)

DB --> API: Service created
API --> Frontend: Success + service data
Frontend --> Admin: Hiển thị thông báo thành công

' ========== UPDATE SERVICE ==========
Admin -> Frontend: Sửa thông tin dịch vụ
Frontend -> API: PUT /api/v1/services/:id\n{ name, description, basePrice, category, unit, schedule }

API -> API: Verify JWT + Check role = admin
API -> DB: Tìm service theo ID
DB --> API: Service found
API -> DB: Cập nhật thông tin dịch vụ
DB --> API: Updated

API --> Frontend: Success + updated service
Frontend --> Admin: Hiển thị thông báo thành công

' ========== DELETE SERVICE ==========
Admin -> Frontend: Xóa dịch vụ
Frontend -> API: DELETE /api/v1/services/:id

API -> API: Verify JWT + Check role = admin
API -> DB: Kiểm tra service có đang được sử dụng?\n(service bookings active)

alt Có service bookings active
    DB --> API: Has active service bookings
    API --> Frontend: Error: "Không thể xóa dịch vụ đang được sử dụng"
    Frontend --> Admin: Hiển thị lỗi
else Không có service bookings active
    DB --> API: No active service bookings
    API -> DB: Soft delete service\n(isActive: false)
    DB --> API: Deleted
    
    API --> Frontend: Success: "Đã xóa dịch vụ"
    Frontend --> Admin: Hiển thị thông báo thành công
end
@enduml

