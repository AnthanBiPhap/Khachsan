@startuml Service Management - Use Case Diagram
!theme plain
skinparam backgroundColor #FFFFFF
skinparam usecase {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
    FontSize 11
}
skinparam actor {
    BackgroundColor #FFF3E0
    BorderColor #E65100
    FontSize 12
    FontStyle bold
}
skinparam rectangle {
    BackgroundColor #F5F5F5
    BorderColor #757575
}

title Service Management - Use Case Diagram\nHệ thống Miko Hotel

' ========== ACTORS ==========
actor "Customer\nKhách hàng" as Customer
actor "Staff\nNhân viên" as Staff
actor "Admin\nQuản trị viên" as Admin

' ========== SERVICE MANAGEMENT USE CASES ==========
rectangle "Service Management" {
    usecase "UC38: Xem danh sách dịch vụ" as UC38
    usecase "UC39: Xem chi tiết dịch vụ" as UC39
    usecase "UC40: Đặt dịch vụ" as UC40
    usecase "UC41: Xem đặt dịch vụ của mình" as UC41
    usecase "UC42: Quản lý dịch vụ (catalog)" as UC42
    usecase "UC43: Quản lý đặt dịch vụ" as UC43
    usecase "UC43A: Cập nhật trạng thái đặt dịch vụ" as UC43A
    usecase "UC43B: Hủy đặt dịch vụ" as UC43B
    usecase "UC43C: Hạch toán dịch vụ vào hóa đơn" as UC43C
}

' ========== CUSTOMER CONNECTIONS ==========
Customer --> UC38 : "Xem danh sách dịch vụ"
Customer --> UC39 : "Xem chi tiết dịch vụ"
Customer --> UC40 : "Đặt dịch vụ"
Customer --> UC41 : "Xem đặt dịch vụ của mình"

' ========== STAFF CONNECTIONS ==========
Staff --> UC42 : "Xem dịch vụ\n(read-only)"
Staff --> UC43 : "Quản lý đặt dịch vụ"
Staff --> UC43A : "Cập nhật trạng thái"
Staff --> UC43B : "Hủy đặt dịch vụ"
Staff --> UC43C : "Hạch toán vào hóa đơn"

' ========== ADMIN CONNECTIONS ==========
Admin --> UC42 : "Quản lý dịch vụ\n(CRUD)"
Admin --> UC43 : "Quản lý đặt dịch vụ"
Admin --> UC43A : "Cập nhật trạng thái"
Admin --> UC43B : "Hủy đặt dịch vụ"
Admin --> UC43C : "Hạch toán vào hóa đơn"

' ========== INCLUDES/EXTENDS RELATIONSHIPS ==========
UC40 ..> UC39 : <<include>>\n"Xem chi tiết trước"
UC40 ..> UC16 : <<include>>\n"Gắn với booking"
UC39 ..> UC38 : <<extend>>\n"Xem chi tiết từ danh sách"
UC41 ..> UC40 : <<extend>>\n"Xem các dịch vụ đã đặt"
UC43A ..> UC43 : <<extend>>\n"Cập nhật từ quản lý"
UC43B ..> UC43 : <<extend>>\n"Hủy từ quản lý"
UC43C ..> UC36 : <<include>>\n"Tạo/cập nhật hóa đơn"

note right of UC38
  Duyệt các dịch vụ:
  - Ăn uống
  - Spa
  - Đưa đón
  - Gym
  - Và các dịch vụ khác
  Lọc theo loại/giá
end note

note right of UC39
  Xem chi tiết dịch vụ:
  - Mô tả
  - Giá cả
  - Điều kiện áp dụng
  - Thời gian phục vụ
  - Hình ảnh
end note

note right of UC40
  Đặt dịch vụ kèm/thuộc một booking
  Chọn:
  - Thời gian
  - Số lượng
  Kiểm tra tính khả dụng
end note

note right of UC41
  Xem danh sách/chi tiết các service bookings
  Gắn với booking của mình
  Trạng thái đặt dịch vụ
end note

note right of UC42
  Admin: Tạo/Sửa/Xóa dịch vụ
  Quản lý:
  - Giá cả
  - Đơn vị
  - Lịch phục vụ
  - Bật/tắt hiển thị
  Staff: chỉ xem (read-only)
end note

note right of UC43
  Tra cứu/duyệt/cập nhật service bookings
  Đồng bộ chi phí vào invoice
  Quản lý toàn bộ đặt dịch vụ
end note

note right of UC43A
  Cập nhật trạng thái:
  - requested
  - confirmed
  - completed
  - cancelled
  Ghi lý do và audit với staff
end note

note right of UC43B
  Hủy theo chính sách
  Hoàn/thu phí nếu có
  Phát notify cho khách
  Cập nhật trạng thái
end note

note right of UC43C
  Gộp chi phí dịch vụ vào invoice của booking
  Không cho sửa sau khi chốt invoice
  Tự động tính toán tổng tiền
end note

@enduml

