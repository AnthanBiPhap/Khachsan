@startuml Algorithm - Duyệt đặt phòng nhóm
!theme plain
title Sơ đồ thuật toán - Duyệt đặt phòng nhóm

start
:Input: groupBookingId, decision (approve/reject);
:Kiểm tra quyền (Staff/Admin);
if (Duyệt?) then (Có)
 :Kiểm tra availability;
 :Cập nhật status = confirmed;
 :Phân bổ phòng dự kiến;
 :Tạo bookings chi tiết;
 :Cập nhật tồn phòng;
else
 :Cập nhật status = rejected;
 :Lưu lý do từ chối;
endif
:Ghi audit log;
:Gửi email thông báo;
:Return SUCCESS;
stop
@enduml

