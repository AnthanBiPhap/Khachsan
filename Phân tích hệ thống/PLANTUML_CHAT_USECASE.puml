@startuml Chat & Realtime Communication - Use Case Diagram
!theme plain
skinparam backgroundColor #FFFFFF
skinparam usecase {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
    FontSize 11
}
skinparam actor {
    BackgroundColor #FFF3E0
    BorderColor #E65100
    FontSize 12
    FontStyle bold
}
skinparam rectangle {
    BackgroundColor #F5F5F5
    BorderColor #757575
}

title Chat & Realtime Communication - Use Case Diagram\nHệ thống Miko Hotel

' ========== ACTORS ==========
actor "Customer\nKhách hàng" as Customer
actor "Staff\nNhân viên" as Staff
actor "Admin\nQuản trị viên" as Admin
actor "System\nHệ thống" as System

' ========== CHAT & REALTIME USE CASES ==========
rectangle "Chat & Realtime Communication" {
    usecase "UC49: Chat với staff/admin" as UC49
    usecase "UC50: Xem lịch sử chat" as UC50
    usecase "UC51: Gửi tin nhắn" as UC51
    usecase "UC52: Nhận thông báo real-time (Socket.IO)" as UC52
    usecase "UC53: Quản lý cuộc trò chuyện" as UC53
    usecase "UC53A: Đánh dấu đã đọc" as UC53A
    usecase "UC53B: Đếm tin nhắn chưa đọc" as UC53B
    usecase "UC53C: Chat theo booking (ngữ cảnh)" as UC53C
}

' ========== CUSTOMER CONNECTIONS ==========
Customer --> UC49 : "Chat với staff/admin"
Customer --> UC50 : "Xem lịch sử chat"
Customer --> UC51 : "Gửi tin nhắn"
Customer --> UC52 : "Nhận thông báo real-time"
Customer --> UC53A : "Đánh dấu đã đọc"
Customer --> UC53B : "Đếm tin nhắn chưa đọc"

' ========== STAFF CONNECTIONS ==========
Staff --> UC50 : "Xem lịch sử chat"
Staff --> UC51 : "Gửi tin nhắn"
Staff --> UC52 : "Nhận thông báo real-time"
Staff --> UC53 : "Quản lý cuộc trò chuyện"
Staff --> UC53A : "Đánh dấu đã đọc"
Staff --> UC53B : "Đếm tin nhắn chưa đọc"
Staff --> UC53C : "Chat theo booking"

' ========== ADMIN CONNECTIONS ==========
Admin --> UC50 : "Xem lịch sử chat"
Admin --> UC51 : "Gửi tin nhắn"
Admin --> UC52 : "Nhận thông báo real-time"
Admin --> UC53 : "Quản lý cuộc trò chuyện"
Admin --> UC53C : "Chat theo booking"

' ========== SYSTEM CONNECTIONS ==========
System --> UC52 : "Socket.IO real-time"
System --> UC49 : "Tự động ghép staff"

' ========== INCLUDES/EXTENDS RELATIONSHIPS ==========
UC49 ..> UC52 : <<include>>\n"Nhận thông báo real-time"
UC51 ..> UC52 : <<include>>\n"Gửi qua Socket.IO"
UC50 ..> UC51 : <<extend>>\n"Xem lịch sử tin nhắn"
UC53A ..> UC53B : <<extend>>\n"Cập nhật đếm chưa đọc"
UC53C ..> UC49 : <<extend>>\n"Chat với ngữ cảnh booking"

note right of UC49
  Khi mở chat, hệ thống tự động:
  - Ghép với staff active
  - Có thể cấu hình tắt fallback admin
  - Tạo conversation mới nếu chưa có
end note

note right of UC50
  Xem danh sách/chi tiết cuộc trò chuyện
  Theo quyền truy cập
  Phân trang
  Lọc theo thời gian
end note

note right of UC51
  Gửi/nhận tin nhắn văn bản
  Kèm đính kèm tùy chọn:
  - Hình ảnh
  - File
  Kiểm tra quyền trong conversation
end note

note right of UC52
  Nhận sự kiện real-time qua Socket.IO:
  - Tin nhắn mới
  - Thay đổi trạng thái
  - Typing indicator
  Tự động update UI
  Fallback polling khi mất kết nối
end note

note right of UC53
  Staff/Admin quản lý:
  - Tham gia/thoát room
  - Chọn cuộc trò chuyện
  - Gắn cờ đã đọc
  - Không xóa hội thoại
  - Chuyển conversation
end note

note right of UC53A
  Mark read theo conversation
  Cập nhật unreadCount server-side
  Đồng bộ với tất cả thiết bị
  Ghi nhận thời điểm đã đọc
end note

note right of UC53B
  API lấy tổng số chưa đọc
  Hiển thị badge/thanh điều hướng
  Cập nhật real-time
  Theo từng conversation
end note

note right of UC53C
  Mở chat từ booking để hỗ trợ theo ngữ cảnh
  Lưu liên kết booking trong conversation
  Hiển thị thông tin booking trong chat
  Staff/Admin có thể xem context
end note

@enduml

