@startuml UC9B_ForgotPassword
!theme plain
title UC9B: Quên mật khẩu qua OTP

actor Customer
participant "Frontend" as Frontend
participant "Backend API" as API
database "Database" as DB
participant "Email Service" as EmailService

Customer -> Frontend: Click "Quên mật khẩu"
Customer -> Frontend: Nhập email
Customer -> Frontend: Submit

Frontend -> API: POST /api/v1/auth/forgot-password\n(email)

API -> DB: Tìm user theo email

alt User không tồn tại
    DB --> API: User not found
    API --> Frontend: Success (không tiết lộ email tồn tại)
    Frontend --> Customer: "Nếu email tồn tại, chúng tôi đã gửi OTP"
else User tồn tại
    DB --> API: User found
    API -> API: Tạo OTP 6 số\n(TTL: 10 phút)
    API -> DB: Lưu OTP + expiresAt
    API -> EmailService: Gửi email OTP
    EmailService --> Customer: Email với OTP
    
    API --> Frontend: Success: "Đã gửi OTP đến email"
    Frontend --> Customer: Hiển thị form nhập OTP
    
    Customer -> Frontend: Nhập OTP
    Customer -> Frontend: Submit OTP
    
    Frontend -> API: POST /api/v1/auth/verify-otp\n(email, otp)
    
    API -> DB: Kiểm tra OTP
    
    alt OTP đúng và chưa hết hạn
        DB --> API: OTP valid
        API -> API: Tạo reset token
        API -> DB: Lưu reset token
        API --> Frontend: Success + reset token
        Frontend --> Customer: Hiển thị form đặt lại mật khẩu
        
        Customer -> Frontend: Nhập mật khẩu mới
        Customer -> Frontend: Xác nhận mật khẩu mới
        Customer -> Frontend: Submit
        
        Frontend -> API: POST /api/v1/auth/reset-password\n(resetToken, newPassword)
        
        API -> API: Verify reset token
        API -> API: Hash password mới
        API -> DB: Cập nhật password
        API -> DB: Xóa OTP và reset token
        DB --> API: Updated
        
        API -> EmailService: Gửi email xác nhận đặt lại mật khẩu
        EmailService --> Customer: Email xác nhận
        
        API --> Frontend: Success: "Đặt lại mật khẩu thành công"
        Frontend --> Customer: Chuyển đến trang đăng nhập
    else OTP sai hoặc hết hạn
        API --> Frontend: Error: "OTP không hợp lệ hoặc đã hết hạn"
        Frontend --> Customer: Hiển thị lỗi
    end
end
@enduml

