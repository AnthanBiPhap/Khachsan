@startuml Algorithm - Lên lịch tác vụ
!theme plain
title Sơ đồ thuật toán - Lên lịch tác vụ

start
:Input: cron schedule;
if (Cleanup OTP hết hạn?) then
 :Tìm OTP với expiredAt < now;
 :Xóa OTP hết hạn;
elseif (Cleanup tokens?) then
 :Tìm verification tokens hết hạn;
 :Xóa tokens hết hạn;
elseif (Cleanup logs?) then
 :Tìm logs cũ hơn 90 ngày;
 :Archive hoặc xóa logs;
elseif (Send scheduled emails?) then
 :Lấy queue emails chưa gửi;
 :Gửi emails trong queue;
endif
:Lưu vào database;
:Return SUCCESS;
stop
@enduml

