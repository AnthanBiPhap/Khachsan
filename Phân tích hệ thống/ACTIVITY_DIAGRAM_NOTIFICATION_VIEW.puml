@startuml Activity Diagram - Xem thông báo & Quản lý (UC54, UC54A, UC55)
!theme plain
title Activity Diagram - Xem thông báo & Quản lý (UC54, UC54A, UC55)

|User|
start
if (Xem thông báo?) then
    :Xem thông báo;
    :Chọn bộ lọc;
    |System|
    :Lấy danh sách notifications;
    :Áp dụng bộ lọc;
    :Phân trang;
    :Trả về danh sách;
elseif (Đếm chưa đọc?) then
    :Đếm thông báo chưa đọc;
    |System|
    :Đếm notifications (status = unread);
    :Trả về tổng số;
    |User|
    :Hiển thị badge;
elseif (Đánh dấu đã đọc?) then
    :Đánh dấu đã đọc;
    :Chọn notification(s);
    |System|
    :Cập nhật status = read;
    :Cập nhật unreadCount;
    |User|
    :Cập nhật UI;
endif
stop
@enduml
