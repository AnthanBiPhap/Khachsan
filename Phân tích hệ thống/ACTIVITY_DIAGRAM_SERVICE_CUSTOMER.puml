@startuml Activity Diagram - Xem và đặt dịch vụ (Customer) - UC38, UC39, UC40
!theme plain
title Activity Diagram - Xem và đặt dịch vụ (Customer) - UC38, UC39, UC40

|Customer|
start
if (Xem danh sách?) then
    :Xem danh sách dịch vụ;
    |System|
    :Lấy danh sách dịch vụ (status = active);
    :Trả về danh sách;
elseif (Xem chi tiết?) then
    :Xem chi tiết dịch vụ;
    :Chọn dịch vụ;
    |System|
    :Lấy chi tiết dịch vụ;
    :Trả về chi tiết;
elseif (Đặt dịch vụ?) then
    :Đặt dịch vụ;
    :Chọn booking;
    :Chọn thời gian/số lượng;
    |System|
    :Kiểm tra booking hợp lệ?;
    :Kiểm tra tính khả dụng dịch vụ;
    if (Không khả dụng?) then (có)
        |Customer|
        :Hiển thị lỗi;
        stop
    endif
    :Tính giá;
    :Tạo service booking (status = requested);
    |System|
    :Gửi email xác nhận;
    :Gửi thông báo realtime;
endif
stop
@enduml
