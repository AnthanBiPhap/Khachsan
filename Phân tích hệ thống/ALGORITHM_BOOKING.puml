@startuml Algorithm - Booking Management (Tổng hợp)
!theme plain
title Sơ đồ thuật toán - Booking Management (Tổng hợp)

start
:Input: action, bookingId, data, filters;
:Validate action;
if (action = "createIndividual"?) then (Có)
    :Gọi thuật toán Đặt phòng cá nhân;
    :Input: roomId, checkIn, checkOut, guests, customerInfo;
    :Kiểm tra availability;
    :Tạo booking;
    :Return: bookingId / ERROR;
elseif (action = "createGroup"?) then (Có)
    :Gọi thuật toán Đặt phòng nhóm;
    :Input: groupInfo, requirements;
    :Tạo group booking request;
    :Return: requestId / ERROR;
elseif (action = "view"?) then (Có)
    :Gọi thuật toán Xem booking;
    :Input: bookingId hoặc filters;
    :Lấy thông tin booking;
    :Kiểm tra quyền truy cập;
    :Return: booking data / ERROR;
elseif (action = "cancel"?) then (Có)
    :Gọi thuật toán Hủy đặt phòng;
    :Input: bookingId, reason;
    :Kiểm tra chính sách hủy;
    :Tạo cancellation request;
    :Return: SUCCESS / ERROR;
elseif (action = "approveCancel"?) then (Có)
    :Kiểm tra quyền Staff/Admin;
    :Gọi thuật toán Duyệt hủy;
    :Input: bookingId, approve, refundAmount;
    :Xử lý hủy và hoàn tiền;
    :Return: SUCCESS / ERROR;
elseif (action = "updateStatus"?) then (Có)
    :Kiểm tra quyền Staff/Admin;
    :Gọi thuật toán Cập nhật trạng thái;
    :Input: bookingId, newStatus;
    :Validate workflow;
    :Return: SUCCESS / ERROR;
elseif (action = "checkin"?) then (Có)
    :Kiểm tra quyền Staff/Admin;
    :Gọi thuật toán Check-in;
    :Input: bookingId, actualCheckIn, actualGuests;
    :Cập nhật booking và phòng;
    :Return: SUCCESS / ERROR;
elseif (action = "checkout"?) then (Có)
    :Kiểm tra quyền Staff/Admin;
    :Gọi thuật toán Check-out;
    :Input: bookingId, actualCheckOut;
    :Tính toán và thanh toán;
    :Return: SUCCESS / ERROR;
elseif (action = "extend"?) then (Có)
    :Kiểm tra quyền Staff/Admin;
    :Gọi thuật toán Gia hạn check-out;
    :Input: bookingId, newCheckOut;
    :Tính phụ thu;
    :Return: SUCCESS / ERROR;
elseif (action = "approveGroup"?) then (Có)
    :Kiểm tra quyền Staff/Admin;
    :Gọi thuật toán Duyệt đặt nhóm;
    :Input: requestId, approve, rooms;
    :Tạo bookings hoặc từ chối;
    :Return: SUCCESS / ERROR;
elseif (action = "createQuote"?) then (Có)
    :Kiểm tra quyền Staff/Admin;
    :Gọi thuật toán Tạo báo giá;
    :Input: requestId, quoteData;
    :Tính giá và tạo quote;
    :Return: quoteId / ERROR;
elseif (action = "manageGuests"?) then (Có)
    :Kiểm tra quyền Staff/Admin;
    :Gọi thuật toán Quản lý khách;
    :Input: bookingId, operation, guestData;
    :Return: SUCCESS / ERROR;
endif
:Return result;
stop
@enduml

