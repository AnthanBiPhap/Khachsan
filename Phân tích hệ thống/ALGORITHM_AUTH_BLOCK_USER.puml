@startuml Algorithm - Khóa/Mở khóa tài khoản
!theme plain
title Sơ đồ thuật toán - Khóa/Mở khóa tài khoản

start
:Input: adminId, targetUserId, action;
:Kiểm tra quyền Admin;
if (action == 'block') then (Khóa)
 :Kiểm tra user đã bị khóa?;
 :Cập nhật status = blocked;
 :Xóa sessions;
 :Ghi audit log;
 :Gửi thông báo realtime;
else (Mở khóa)
 :Kiểm tra user đã bị khóa?;
 :Cập nhật status = active;
 :Ghi audit log;
endif
:Return SUCCESS;
stop
@enduml

