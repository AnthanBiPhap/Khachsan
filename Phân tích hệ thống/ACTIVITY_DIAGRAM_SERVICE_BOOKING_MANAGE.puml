@startuml Activity Diagram - Quản lý đặt dịch vụ (Staff/Admin) - UC43, UC43A, UC43B, UC43C
!theme plain
title Activity Diagram - Quản lý đặt dịch vụ (Staff/Admin) - UC43, UC43A, UC43B, UC43C

|Staff/Admin|
start
if (Quản lý đặt dịch vụ?) then
    :Quản lý đặt dịch vụ;
    :Nhập tiêu chí lọc;
    |System|
    :Lấy service bookings từ database;
    :Áp dụng bộ lọc;
    :Phân trang;
    :Trả về danh sách;
elseif (Cập nhật trạng thái?) then
    :Cập nhật trạng thái;
    :Chọn trạng thái mới;
    |System|
    :Cập nhật status;
    :Ghi audit log;
elseif (Hủy đặt dịch vụ?) then
    :Hủy đặt dịch vụ;
    :Xác nhận hủy;
    |System|
    :Cập nhật status = cancelled;
    :Hoàn tiền (nếu đã thanh toán);
    :Gửi email thông báo;
elseif (Hạch toán vào hóa đơn?) then
    :Hạch toán vào hóa đơn;
    :Chọn service booking;
    :Chọn invoice;
    |System|
    :Gắn service booking với invoice;
    :Cập nhật tổng tiền invoice;
    :Lưu vào database;
endif
stop
@enduml
