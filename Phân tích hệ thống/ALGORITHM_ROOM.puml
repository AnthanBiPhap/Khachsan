@startuml Algorithm - Room Management (Tổng hợp)
!theme plain
title Sơ đồ thuật toán - Room Management (Tổng hợp)

start
:Input: action, roomId, filters, data;
:Validate action;
if (action = "list"?) then (Có)
    :Gọi thuật toán Xem danh sách;
    :Input: filters, pagination;
    :Lấy danh sách phòng từ DB;
    :Áp dụng filters;
    :Return: danh sách phòng;
elseif (action = "search"?) then (Có)
    :Gọi thuật toán Tìm kiếm;
    :Input: searchCriteria;
    :Tìm kiếm phòng theo criteria;
    :Kiểm tra availability;
    :Return: danh sách phòng khả dụng;
elseif (action = "detail"?) then (Có)
    :Gọi thuật toán Xem chi tiết;
    :Input: roomId;
    :Lấy thông tin phòng;
    :Lấy thông tin loại phòng;
    :Lấy tiện nghi, hình ảnh;
    :Return: chi tiết phòng;
elseif (action = "roomTypes"?) then (Có)
    :Gọi thuật toán Xem loại phòng;
    :Input: filters;
    :Lấy danh sách loại phòng;
    :Return: danh sách loại phòng;
elseif (action = "manage"?) then (Có)
    :Kiểm tra quyền Admin;
    if (Không có quyền?) then (Có)
        :Return ERROR: UNAUTHORIZED;
        stop
    endif
    :Gọi thuật toán Quản lý phòng;
    :Input: operation, roomData;
    :Return: SUCCESS/ERROR;
elseif (action = "manageRoomType"?) then (Có)
    :Kiểm tra quyền Admin;
    if (Không có quyền?) then (Có)
        :Return ERROR: UNAUTHORIZED;
        stop
    endif
    :Gọi thuật toán Quản lý loại phòng;
    :Input: operation, roomTypeData;
    :Return: SUCCESS/ERROR;
elseif (action = "updateStatus"?) then (Có)
    :Kiểm tra quyền Admin;
    if (Không có quyền?) then (Có)
        :Return ERROR: UNAUTHORIZED;
        stop
    endif
    :Gọi thuật toán Cập nhật trạng thái;
    :Input: roomId, newStatus, reason;
    :Return: SUCCESS/ERROR;
endif
:Return result;
stop
@enduml

