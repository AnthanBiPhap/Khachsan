@startuml Algorithm - System Automation & Integrations (Tổng hợp)
!theme plain
title Sơ đồ thuật toán - System Automation & Integrations (Tổng hợp)

start
:Input: eventType, context, data;
:Validate eventType;
if (eventType = "userRegistered"?) then (Có)
    :Gọi thuật toán Email xác nhận đăng ký;
    :Input: userId, email;
    :Tạo verification token;
    :Gửi email async;
    :Return: SUCCESS;
elseif (eventType = "forgotPassword"?) then (Có)
    :Gọi thuật toán Gửi OTP;
    :Input: userId, email;
    :Tạo OTP 6 số;
    :Gửi email async;
    :Return: SUCCESS;
elseif (eventType = "passwordReset"?) then (Có)
    :Gọi thuật toán Xác nhận đặt lại mật khẩu;
    :Input: userId, email;
    :Gửi email xác nhận async;
    :Return: SUCCESS;
elseif (eventType = "invoiceCreated"?) then (Có)
    :Gọi thuật toán Email hóa đơn;
    :Input: invoiceId, bookingId;
    :Tạo PDF invoice;
    :Gửi email với PDF đính kèm;
    :Return: SUCCESS;
elseif (eventType = "bookingCreated" hoặc "bookingUpdated"?) then (Có)
    :Gọi thuật toán Thông báo booking;
    :Input: bookingId, eventType;
    :Tạo notifications;
    :Phát real-time;
    :Return: SUCCESS;
elseif (eventType = "paymentSuccess" hoặc "paymentFailed"?) then (Có)
    :Gọi thuật toán Thông báo payment;
    :Input: paymentId, eventType;
    :Tạo notifications;
    :Phát real-time;
    :Return: SUCCESS;
elseif (eventType = "groupBookingRequest"?) then (Có)
    :Gọi thuật toán Thông báo đặt đoàn;
    :Input: groupBookingId, eventType;
    :Tạo notifications cho Staff/Admin;
    :Phát real-time;
    :Return: SUCCESS;
elseif (eventType = "stripeWebhook"?) then (Có)
    :Gọi thuật toán Stripe;
    :Input: webhookData, signature;
    :Xác minh signature;
    :Xử lý payment;
    :Return: SUCCESS / ERROR;
elseif (eventType = "autoStatusUpdate"?) then (Có)
    :Gọi thuật toán Cập nhật trạng thái tự động;
    :Input: currentTime;
    :Kiểm tra bookings hết hạn;
    :Cập nhật status;
    :Return: số lượng đã cập nhật;
elseif (eventType = "schedulerTask"?) then (Có)
    :Gọi thuật toán Scheduler;
    :Input: taskType;
    :Chạy scheduled tasks;
    :Return: SUCCESS;
endif
:Return result;
stop
@enduml

