@startuml Activity Diagram - Booking Management (Tổng hợp)
!theme plain
title Activity Diagram - Booking Management (Tổng hợp)

|Customer|
start
if (Đặt phòng cá nhân?) then
    :Đặt phòng cá nhân;
    |System|
    :Kiểm tra tồn phòng;
    :Tạo booking;
elseif (Đặt phòng nhóm?) then
    :Đặt phòng nhóm;
    |System|
    :Tạo group booking request;
elseif (Xem booking?) then
    :Xem đặt phòng của mình;
elseif (Hủy đặt phòng?) then
    :Hủy đặt phòng;
    |System|
    :Chờ duyệt;
endif
|Staff/Admin|
if (Quản lý bookings?) then
    :Xem danh sách/chi tiết;
    :Cập nhật trạng thái;
    :Check-in;
    :Check-out;
    :Gia hạn check-out;
    :Duyệt đặt phòng nhóm;
    :Tạo báo giá;
    :Quản lý thông tin khách;
endif
stop
@enduml

