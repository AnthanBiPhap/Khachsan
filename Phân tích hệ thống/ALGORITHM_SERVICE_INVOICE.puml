@startuml Algorithm - Hạch toán dịch vụ vào hóa đơn
!theme plain
title Sơ đồ thuật toán - Hạch toán dịch vụ vào hóa đơn

start
:Input: bookingId;
:Kiểm tra hóa đơn đã completed?;
if (Hóa đơn đã completed?) then (Có)
 :Return ERROR: "Không thể sửa";
 stop
endif
:Lấy danh sách service bookings (status = completed);
:Tính tổng chi phí dịch vụ;
if (Chưa có invoice?) then (Có)
 :Tạo invoice mới;
else
 :Kiểm tra dịch vụ đã được thêm?;
 if (Chưa được thêm?) then (Có)
 :Thêm dòng chi phí dịch vụ;
 else
 :Cập nhật dòng chi phí (nếu thay đổi);
 endif
endif
:Cập nhật tổng tiền invoice;
:Lưu vào database;
:Ghi audit log;
:Return SUCCESS;
stop
@enduml

