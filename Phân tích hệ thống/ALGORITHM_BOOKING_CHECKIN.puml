@startuml Algorithm - Check-in khách
!theme plain
title Sơ đồ thuật toán - Check-in khách

start
:Input: bookingId, guestInfo;
:Kiểm tra booking status = confirmed;
:Xác thực khách (CMND/CCCD);
:Cập nhật booking status = checked_in;
:Cập nhật phòng status = occupied;
:Cập nhật availability;
:Ghi nhận thời điểm check-in;
:Cập nhật thông tin khách đi kèm (nếu có);
:Ghi audit log;
:Gửi email xác nhận;
:Return SUCCESS;
stop
@enduml

