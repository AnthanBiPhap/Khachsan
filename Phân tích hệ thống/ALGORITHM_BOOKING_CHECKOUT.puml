@startuml Algorithm - Check-out khách
!theme plain
title Sơ đồ thuật toán - Check-out khách

start
:Input: bookingId;
:Kiểm tra booking status = checked_in;
:Chốt công nợ/dịch vụ;
:Kiểm tra thanh toán đã đủ?;
if (Chưa thanh toán đủ?) then (Có)
 :Return ERROR: "Chưa thanh toán đủ";
 stop
endif
if (Chưa có invoice?) then (Có)
 :Tạo invoice;
endif
:Cập nhật booking status = checked_out;
:Cập nhật phòng status = available/cleaning;
:Cập nhật availability;
:Chốt invoice;
:Ghi nhận thời điểm check-out;
:Ghi audit log;
:Gửi email xác nhận;
:Return SUCCESS;
stop
@enduml

