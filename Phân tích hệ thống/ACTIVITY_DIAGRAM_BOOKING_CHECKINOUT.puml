@startuml Activity Diagram - Check-in/Check-out (UC23, UC24, UC25)
!theme plain
title Activity Diagram - Check-in/Check-out (UC23, UC24, UC25)

|Staff/Admin|
start
if (Check-in?) then
    :Check-in khách;
    :Xác thực khách;
    :Kiểm tra phòng sẵn sàng?;
    |System|
    :Cập nhật status = checked_in;
    :Cập nhật trạng thái phòng = occupied;
    |System|
    :Gửi email xác nhận;
elseif (Check-out?) then
    :Check-out khách;
    :Kiểm tra công nợ;
    :Kiểm tra dịch vụ sử dụng;
    if (Chưa có hóa đơn?) then (có)
        :Phát sinh hóa đơn;
        |System|
        :Tạo invoice;
        :Tính tổng tiền;
    endif
    :Thanh toán (nếu còn nợ);
    |System|
    :Cập nhật status = checked_out;
    :Cập nhật trạng thái phòng = available;
    |System|
    :Gửi email xác nhận;
elseif (Gia hạn check-out?) then
    :Gia hạn check-out;
    :Nhập thời gian gia hạn;
    |System|
    :Tính phụ thu;
    :Cập nhật check-out time;
    :Tạo phụ phí;
endif
stop
@enduml
