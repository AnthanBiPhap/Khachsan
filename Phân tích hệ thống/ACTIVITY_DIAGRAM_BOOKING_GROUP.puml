@startuml Activity Diagram - Đặt phòng nhóm  & Duyệt/Báo giá (UC26, UC27)
!theme plain
title Activity Diagram - Đặt phòng nhóm  & Duyệt/Báo giá (UC26, UC27)

|Customer|
start
if (Đặt phòng nhóm?) then
    :Đặt phòng nhóm;
    :Điền form yêu cầu đặt đoàn;
    |System|
    :Tạo group booking (status = pending);
    :Lưu vào database;
    |System|
    :Gửi email xác nhận;
    :Gửi thông báo realtime;
endif
|Staff/Admin|
if (Xử lý yêu cầu?) then
    :Xem yêu cầu đặt đoàn;
    :Kiểm tra khả năng đáp ứng;
    if (Có thể đáp ứng?) then (có)
        :Tạo báo giá;
        :Lập báo giá chi tiết;
        |System|
        :Tính tổng giá;
        :Lưu báo giá;
        :Cập nhật status = quoted;
        |System|
        :Gửi email báo giá;
        :Gửi link thanh toán;
    else
        :Từ chối yêu cầu;
        |System|
        :Cập nhật status = rejected;
        |System|
        :Gửi email thông báo;
    endif
endif
stop
@enduml
