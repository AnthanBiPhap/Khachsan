@startuml Algorithm - Chat & Realtime Communication (Tổng hợp)
!theme plain
title Sơ đồ thuật toán - Chat & Realtime Communication (Tổng hợp)

start
:Input: action, conversationId, messageData, filters;
:Validate action;
if (action = "openChat"?) then (Có)
    :Gọi thuật toán Mở chat;
    :Input: userId, customerId;
    :Tìm hoặc tạo conversation;
    :Gán staff nếu có;
    :Return: conversationId;
elseif (action = "sendMessage"?) then (Có)
    :Gọi thuật toán Gửi tin nhắn;
    :Input: conversationId, senderId, content, type;
    :Validate quyền trong conversation;
    :Lưu message vào DB;
    :Phát event real-time;
    :Return: messageId / ERROR;
elseif (action = "viewHistory"?) then (Có)
    :Gọi thuật toán Xem lịch sử;
    :Input: conversationId, pagination;
    :Lấy messages từ DB;
    :Kiểm tra quyền truy cập;
    :Return: danh sách messages;
elseif (action = "realtime"?) then (Có)
    :Gọi thuật toán Real-time;
    :Input: socketId, conversationId;
    :Join Socket.IO room;
    :Lắng nghe events;
    :Return: connection status;
elseif (action = "markRead"?) then (Có)
    :Gọi thuật toán Đánh dấu đã đọc;
    :Input: conversationId, userId;
    :Cập nhật unreadCount = 0;
    :Return: SUCCESS;
elseif (action = "unreadCount"?) then (Có)
    :Gọi thuật toán Đếm chưa đọc;
    :Input: userId;
    :Tính tổng unreadCount từ conversations;
    :Return: totalUnreadCount;
elseif (action = "manageConversation"?) then (Có)
    :Kiểm tra quyền Staff/Admin;
    :Gọi thuật toán Quản lý conversation;
    :Input: conversationId, operation;
    :Return: SUCCESS / ERROR;
elseif (action = "linkBooking"?) then (Có)
    :Kiểm tra quyền Staff/Admin;
    :Gọi thuật toán Gắn với booking;
    :Input: conversationId, bookingId;
    :Gắn booking context;
    :Return: SUCCESS / ERROR;
endif
:Return result;
stop
@enduml

