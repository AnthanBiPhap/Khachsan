@startuml Activity Diagram - Xem và Tìm kiếm Phòng (UC9, UC10, UC11, UC12)
!theme plain
title Activity Diagram - Xem và Tìm kiếm Phòng (UC9, UC10, UC11, UC12)

|User|
start
if (Xem danh sách?) then
    :Xem danh sách phòng;
    |System|
    :Lấy danh sách phòng;
    :Lọc theo quyền;
    :Trả về danh sách;
elseif (Tìm kiếm?) then
    :Tìm kiếm phòng;
    :Nhập tiêu chí tìm kiếm;
    |System|
    :Kiểm tra ngày hợp lệ?;
    :Tìm kiếm theo tiêu chí;
    :Kiểm tra availability;
    :Trả về kết quả;
elseif (Xem chi tiết?) then
    :Xem chi tiết phòng;
    :Chọn phòng;
    |System|
    :Lấy chi tiết phòng;
    :Lấy mô tả, tiện nghi, hình ảnh, giá;
    :Trả về chi tiết;
elseif (Xem loại phòng?) then
    :Xem loại phòng;
    |System|
    :Lấy danh sách loại phòng;
    :Trả về danh sách;
endif
stop
@enduml
