@startuml Algorithm - Đặt dịch vụ
!theme plain
title Sơ đồ thuật toán - Đặt dịch vụ

start
:Input: serviceId, bookingId, time, quantity;
:Validate input;
:Kiểm tra booking hợp lệ?;
:Kiểm tra dịch vụ có sẵn? (status = active);
:Kiểm tra tính khả dụng (capacity, lịch phục vụ);
if (Không khả dụng?) then (Có)
 :Return ERROR;
 stop
endif
:Tính giá dịch vụ (giá × số lượng);
:Tạo service booking (status = requested);
:Gắn với booking;
:Lưu thời gian phục vụ;
:Lưu số lượng;
:Cập nhật capacity (reserve);
:Gửi thông báo cho Staff/Admin;
:Return SUCCESS;
stop
@enduml

