@startuml Algorithm - Thanh toán chuyển khoản
!theme plain
title Sơ đồ thuật toán - Thanh toán chuyển khoản

start
:Input: bookingId, amount, referenceCode;
:Validate input;
:Kiểm tra mã tham chiếu trùng?;
if (Mã trùng?) then (Có)
 :Return ERROR;
 stop
endif
:Tạo payment record;
:Set payment method = bank_transfer;
:Set status = paid;
:Lưu mã tham chiếu;
:Cập nhật booking payment status;
:Kiểm tra đã thanh toán đủ?;
if (Đã đủ?) then (Có)
 :Cập nhật booking status = paid;
else
 :Cập nhật booking status = partially_paid;
endif
:Ghi audit log;
:Gửi email xác nhận;
:Return SUCCESS;
stop
@enduml

