@startuml UC29_StripePayment
!theme plain
title UC29: Thanh toán online (Stripe)

actor Customer
participant "Frontend" as Frontend
participant "Stripe API" as Stripe
participant "Backend API" as API
database "Database" as DB

Customer -> Frontend: Chọn "Thanh toán online"
Customer -> Frontend: Xác nhận thông tin booking
Customer -> Frontend: Click "Thanh toán"

Frontend -> API: POST /api/stripe/checkout\n{ roomId, totalPrice, checkIn, checkOut, guests, services }

API -> API: Tạo Stripe Checkout Session\n(metadata: booking info)
API -> Stripe: Create Checkout Session\n(line_items, success_url, cancel_url)

Stripe --> API: Checkout Session URL
API --> Frontend: Success + checkout URL
Frontend --> Customer: Redirect đến Stripe Checkout

Customer -> Stripe: Nhập thông tin thẻ
Customer -> Stripe: Submit payment

Stripe -> Stripe: Xử lý thanh toán

alt Thanh toán thành công
    Stripe --> Customer: Redirect đến success_url\n(session_id)
    
    Customer -> Frontend: Truy cập /stripe/success?session_id=xxx
    Frontend -> API: POST /api/stripe/webhook\n(session_id, event: checkout.session.completed)
    
    API -> Stripe: Verify session\n(GET /checkout/sessions/:id)
    Stripe --> API: Session data
    
    API -> API: Extract booking data từ metadata
    API -> DB: Tạo booking\n(status: pending, paymentStatus: paid)
    API -> DB: Tạo payment record\n(paymentMethod: stripe, status: completed)
    API -> DB: Cập nhật invoice\n(paymentStatus: paid)
    API -> DB: Tạo booking status log
    DB --> API: Booking + Payment created
    
    API -> API: Gửi email xác nhận thanh toán\n(kèm PDF hóa đơn)
    API --> Frontend: Success: "Thanh toán thành công"
    Frontend --> Customer: Hiển thị thông báo\n"Đặt phòng thành công"
else Thanh toán thất bại
    Stripe --> Customer: Redirect đến cancel_url
    Frontend --> Customer: Hiển thị thông báo\n"Thanh toán thất bại"
end
@enduml

