@startuml Activity_ImportExport_Admin
!theme plain

|Admin/Staff|
start
:Export báo cáo Excel/PDF\nhoặc Export danh sách booking\nhoặc Export danh sách khách hàng\nhoặc Import danh sách khách hàng;

|System|
if (Export báo cáo?) then (có)
    :Lấy dữ liệu báo cáo với bộ lọc;
    :Tạo file Excel hoặc PDF;
    :result = "SUCCESS - File báo cáo";
elseif (Export danh sách booking?) then (có)
    :Lấy danh sách booking với filters;
    :Tạo Excel file;
    :result = "SUCCESS - File Excel";
elseif (Export danh sách khách hàng?) then (có)
    :Lấy danh sách users;
    :Tạo Excel file;
    :result = "SUCCESS - File Excel";
elseif (Import danh sách khách hàng?) then (có)
    :Đọc và validate file Excel;
    :Tạo users từ Excel;
    :result = "SUCCESS - Import thành công";
else (không)
    :result = "ERROR";
endif

|Admin/Staff|
:Hiển thị kết quả;
stop

@enduml

