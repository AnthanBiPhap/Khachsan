@startuml Activity_Dashboard_Admin
!theme plain

|Admin|
start
:Xem dashboard tổng quan\nhoặc Xem báo cáo chi tiết\nhoặc Xuất báo cáo Excel/PDF\nhoặc Quản lý khách hàng;

|System|
if (Xem dashboard?) then (có)
    :Lấy dữ liệu thống kê\n(đặt phòng, công suất, doanh thu, tỷ lệ hủy);
    :Tính toán biểu đồ xu hướng;
    :result = "SUCCESS - Dashboard data";
elseif (Xem báo cáo chi tiết?) then (có)
    :Lấy dữ liệu báo cáo với bộ lọc\n(ngày/tuần/tháng, loại phòng, kênh, trạng thái);
    :result = "SUCCESS - Báo cáo chi tiết";
elseif (Xuất báo cáo?) then (có)
    :Lấy dữ liệu với bộ lọc;
    :Tạo file Excel hoặc PDF;
    :result = "SUCCESS - File báo cáo";
elseif (Quản lý khách hàng?) then (có)
    if (Xem danh sách?) then (có)
        :Lấy danh sách users;
        :result = "SUCCESS - Danh sách khách hàng";
    elseif (Xem chi tiết?) then (có)
        :Lấy thông tin và lịch sử đặt phòng;
        :result = "SUCCESS - Chi tiết khách hàng";
    else (không)
        :Cập nhật thông tin khách hàng;
        :result = "SUCCESS";
    endif
else (không)
    :result = "ERROR";
endif

|Admin|
:Hiển thị kết quả;
stop

@enduml

