@startuml Activity_Dashboard_Admin
!theme plain

|Admin|
start
:Quản lý dashboard;

|System|
if (Xem dashboard tổng quan?) then (có)
    :Lấy dữ liệu và tính toán thống kê;
    :Hiển thị dashboard;
elseif (Xuất báo cáo?) then (có)
    :Lấy dữ liệu với bộ lọc;
    :Tạo file Excel hoặc PDF;
    :Xuất báo cáo thành công;
else (không)
    :Kiểm tra điều kiện và thực hiện CRUD;
    if (Thành công?) then (không)
        :Hiển thị lỗi;
    else (có)
        :Thực hiện thành công;
    endif
endif

|Admin|
:Hiển thị kết quả;
stop

@enduml

