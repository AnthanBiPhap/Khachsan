@startuml Activity_AI_Customer
!theme plain

|Customer|
start
:Hỏi về phòng/dịch vụ/địa điểm\nhoặc Xem gợi ý dựa trên sở thích;

|System|
if (Hỏi với AI?) then (có)
    :Gửi câu hỏi đến Groq API;
    if (API thành công?) then (có)
        :Nhận phản hồi từ AI;
        :result = "SUCCESS - Gợi ý từ AI";
    else (không)
        :Sử dụng fallback response;
        :result = "SUCCESS - Gợi ý dự phòng";
    endif
else (không)
    :Phân tích sở thích và lịch sử đặt phòng;
    :Gợi ý phòng/dịch vụ phù hợp;
    :result = "SUCCESS - Gợi ý cá nhân hóa";
endif

|Customer|
:Hiển thị kết quả;
stop

@enduml

