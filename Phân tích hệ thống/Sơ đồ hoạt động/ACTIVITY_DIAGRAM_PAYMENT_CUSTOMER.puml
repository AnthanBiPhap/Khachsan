@startuml Activity_Payment_Customer
!theme plain

|Customer|
start
:Quản lý thanh toán;

|System|
if (Thanh toán online?) then (có)
    :Tạo Stripe checkout session;
    :Xử lý thanh toán;
    if (Thanh toán thành công?) then (có)
        :Thanh toán thành công;
    else (không)
        :Thanh toán thất bại;
    endif
else (không)
    :Kiểm tra điều kiện và thực hiện CRUD;
    if (Thành công?) then (không)
        :Hiển thị lỗi;
    else (có)
        :Thực hiện thành công;
    endif
endif

|Customer|
:Hiển thị kết quả;
stop

@enduml

