@startuml Activity_Booking_Admin
!theme plain

|Admin|
start
:Quản lý booking\n(Xem danh sách/Check-in/Check-out/Duyệt nhóm/Phân bổ phòng);

|System|
if (Check-in/Check-out?) then (có)
    :Cập nhật trạng thái booking;
    :Cập nhật trạng thái phòng;
    :result = "SUCCESS";
elseif (Gia hạn check-out?) then (có)
    :Cập nhật thời gian check-out;
    :Tính toán chi phí phát sinh;
    :result = "SUCCESS";
elseif (Duyệt đặt phòng nhóm?) then (có)
    :Phân bổ phòng cụ thể cho đoàn;
    :Tạo báo giá;
    :result = "SUCCESS";
elseif (Cập nhật trạng thái?) then (có)
    :Cập nhật trạng thái booking;
    :result = "SUCCESS";
else (không)
    :Lấy danh sách hoặc chi tiết booking;
    :result = "SUCCESS";
endif

|Admin|
:Hiển thị kết quả;
stop

@enduml

