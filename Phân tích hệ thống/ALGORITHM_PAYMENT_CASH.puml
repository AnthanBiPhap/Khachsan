@startuml Algorithm - Thanh toán tiền mặt
!theme plain
title Sơ đồ thuật toán - Thanh toán tiền mặt

start
:Input: bookingId, amount, staffId;
:Validate input;
:Tạo payment record;
:Set payment method = cash;
:Set status = paid;
:Cập nhật booking payment status;
:Kiểm tra đã thanh toán đủ?;
if (Đã đủ?) then (Có)
 :Cập nhật booking status = paid;
else
 :Cập nhật booking status = partially_paid;
endif
:Cập nhật invoice status;
:Ghi audit log;
:Gửi email xác nhận;
:Return SUCCESS;
stop
@enduml

