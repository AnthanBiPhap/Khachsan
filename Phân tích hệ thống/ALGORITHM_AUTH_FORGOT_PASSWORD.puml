@startuml Algorithm - Quên mật khẩu qua OTP
!theme plain
title Sơ đồ thuật toán - Quên mật khẩu qua OTP

start
partition "Gửi OTP" {
 :Input: email;
 :Validate email;
 :Tìm user theo email;
 if (User tồn tại?) then (Có)
 :Kiểm tra rate limit (1 OTP/phút);
 if (Đã gửi gần đây?) then (Có)
 :Return SUCCESS;
 stop
 endif
 :Tạo OTP 6 số;
 :Hash OTP;
 :Lưu OTP (TTL 10 phút);
 :Gửi email OTP;
 endif
 :Return SUCCESS (chống lộ thông tin);
 stop
}

partition "Xác minh OTP và đặt lại mật khẩu" {
 :Input: email, otpCode, newPassword;
 :Validate input;
 :Tìm user;
 :Tìm OTP chưa sử dụng;
 :So sánh OTP;
 if (OTP không khớp?) then (Có)
 :Return ERROR;
 stop
 endif
 :Kiểm tra OTP hết hạn?;
 if (OTP hết hạn?) then (Có)
 :Return ERROR;
 stop
 endif
 :Kiểm tra độ mạnh mật khẩu;
 if (Mật khẩu không đủ mạnh?) then (Có)
 :Return ERROR;
 stop
 endif
 :Hash mật khẩu mới;
 :Cập nhật mật khẩu;
 :Đánh dấu OTP đã dùng;
 :Xóa session tokens cũ;
 :Gửi email xác nhận;
 :Return SUCCESS;
 stop
}
@enduml

