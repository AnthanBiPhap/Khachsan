@startuml Algorithm - Đăng nhập
!theme plain
title Sơ đồ thuật toán - Đăng nhập

start
:Input: email, password;
:Validate input;
:Tìm user theo email;
if (User không tồn tại?) then (Có)
 :Return ERROR;
 stop
endif
:Kiểm tra status user;
if (Status = blocked/deleted?) then (Có)
 :Return ERROR;
 stop
endif
:Kiểm tra password;
if (Password không đúng?) then (Có)
 :Increment failedLoginAttempts;
 if (failedLoginAttempts >= 5) then (Có)
 :Khóa tài khoản;
 stop
 endif
 :Return ERROR;
 stop
endif
:Reset failedLoginAttempts;
:Tạo JWT token;
:Lưu token vào whitelist;
:Return SUCCESS + token;
stop
@enduml

