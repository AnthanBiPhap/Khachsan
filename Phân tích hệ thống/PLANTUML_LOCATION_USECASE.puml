@startuml Location Management - Use Case Diagram
!theme plain
skinparam backgroundColor #FFFFFF
skinparam usecase {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
    FontSize 11
}
skinparam actor {
    BackgroundColor #FFF3E0
    BorderColor #E65100
    FontSize 12
    FontStyle bold
}
skinparam rectangle {
    BackgroundColor #F5F5F5
    BorderColor #757575
}

title Location Management - Use Case Diagram\nHệ thống Miko Hotel

' ========== ACTORS ==========
actor "Customer\nKhách hàng" as Customer
actor "Staff\nNhân viên" as Staff
actor "Admin\nQuản trị viên" as Admin

' ========== LOCATION MANAGEMENT USE CASES ==========
rectangle "Location Management" {
    usecase "UC58: Xem danh sách địa điểm" as UC58
    usecase "UC59: Xem chi tiết địa điểm" as UC59
    usecase "UC60: Tìm kiếm địa điểm" as UC60
    usecase "UC61: Quản lý địa điểm (catalog)" as UC61
}

' ========== CUSTOMER CONNECTIONS ==========
Customer --> UC58 : "Xem danh sách địa điểm"
Customer --> UC59 : "Xem chi tiết địa điểm"
Customer --> UC60 : "Tìm kiếm địa điểm"

' ========== STAFF CONNECTIONS ==========
Staff --> UC58 : "Xem danh sách địa điểm\n(read-only)"
Staff --> UC59 : "Xem chi tiết địa điểm\n(read-only)"
Staff --> UC60 : "Tìm kiếm địa điểm\n(read-only)"
Staff --> UC61 : "Xem địa điểm\n(read-only)"

' ========== ADMIN CONNECTIONS ==========
Admin --> UC58 : "Xem danh sách địa điểm"
Admin --> UC59 : "Xem chi tiết địa điểm"
Admin --> UC60 : "Tìm kiếm địa điểm"
Admin --> UC61 : "Quản lý địa điểm\n(CRUD)"

' ========== INCLUDES/EXTENDS RELATIONSHIPS ==========
UC60 ..> UC58 : <<include>>\n"Tìm từ danh sách"
UC59 ..> UC58 : <<extend>>\n"Xem chi tiết từ danh sách"
UC61 ..> UC58 : <<extend>>\n"Quản lý từ danh sách"

note right of UC58
  Duyệt các địa điểm:
  - Điểm tham quan
  - Khu vực lân cận
  - Nhà hàng
  - Khu vui chơi
  - Bảo tàng
  - Vườn quốc gia
  Phục vụ tra cứu
end note

note right of UC59
  Xem chi tiết địa điểm:
  - Mô tả
  - Hình ảnh
  - Vị trí (coordinates)
  - Thời gian mở cửa
  - Gợi ý di chuyển
  - Đánh giá
  - Khoảng cách từ khách sạn
end note

note right of UC60
  Tìm kiếm địa điểm:
  - Theo tên
  - Theo loại
  - Theo khoảng cách
  Lọc nâng cao:
  - Khoảng cách
  - Loại địa điểm
  - Đánh giá
  - Thời gian mở cửa
end note

note right of UC61
  Admin: Quản lý địa điểm (CRUD)
  - Tạo địa điểm mới
  - Sửa thông tin địa điểm
  - Xóa địa điểm
  - Bật/tắt hiển thị
  - Upload hình ảnh
  - Cập nhật thông tin
  Staff: chỉ xem (read-only)
end note

@enduml

