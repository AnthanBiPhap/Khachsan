@startuml Algorithm - Đổi mật khẩu
!theme plain
title Sơ đồ thuật toán - Đổi mật khẩu

start
:Input: userId, oldPassword, newPassword;
:Validate input;
if (Input không hợp lệ?) then (Có)
 :Return ERROR;
 stop
endif
:Lấy user;
:Kiểm tra mật khẩu cũ;
if (Mật khẩu cũ không đúng?) then (Có)
 :Increment failedAttempts;
 if (failedAttempts >= 5) then (Có)
 :Khóa tài khoản;
 stop
 endif
 :Return ERROR;
 stop
endif
:Kiểm tra độ mạnh mật khẩu mới;
if (Mật khẩu không đủ mạnh?) then (Có)
 :Return ERROR;
 stop
endif
:Hash mật khẩu mới;
:Cập nhật mật khẩu;
:Ghi audit log;
:Return SUCCESS;
stop
@enduml

