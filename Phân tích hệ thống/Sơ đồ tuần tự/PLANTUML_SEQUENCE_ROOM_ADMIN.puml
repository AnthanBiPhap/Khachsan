@startuml Room_Admin
!theme plain

actor Admin
participant "Frontend\nAdmin/src/pages/RoomsPage/RoomsPage.tsx" as Frontend
participant "Backend API\n/src/controllers/rooms.controller.ts" as API
database "MongoDB\n(Collection: rooms)" as DB

Admin -> Frontend: Tạo phòng mới
Frontend -> API: (roomNumber, typeId, amenities, images)

API -> API: Verify JWT + Check role = admin
API -> DB: Kiểm tra roomNumber đã tồn tại?

alt RoomNumber đã tồn tại
    DB --> API: Room exists
    API --> Frontend: Error: Số phòng đã tồn tại
    Frontend --> Admin: Hiển thị lỗi
else RoomNumber chưa tồn tại
    DB --> API: RoomNumber available
    API -> DB: Tạo phòng mới
    DB --> API: Room created
    API --> Frontend: Success
    Frontend --> Admin: Hiển thị thành công
end

Admin -> Frontend: Sửa thông tin phòng
Frontend -> API: (roomId, roomNumber, typeId, amenities, images)

API -> API: Verify JWT + Check role = admin
API -> DB: Cập nhật thông tin phòng
DB --> API: Updated

API --> Frontend: Success
Frontend --> Admin: Hiển thị thành công

Admin -> Frontend: Xóa phòng
Frontend -> API: (roomId)

API -> API: Verify JWT + Check role = admin
API -> DB: Kiểm tra phòng có booking active?

alt Có booking active
    DB --> API: Has active bookings
    API --> Frontend: Error: Không thể xóa
    Frontend --> Admin: Hiển thị lỗi
else Không có booking active
    DB --> API: No active bookings
    API -> DB: Soft delete phòng
    DB --> API: Deleted
    API --> Frontend: Success
    Frontend --> Admin: Hiển thị thành công
end

Admin -> Frontend: Cập nhật trạng thái phòng
Frontend -> API: (roomId, status)

API -> API: Verify JWT + Check role = admin
API -> DB: Cập nhật trạng thái\n(available, booked, maintenance, checked_in, occupied, unavailable)
DB --> API: Updated

API --> Frontend: Success
Frontend --> Admin: Hiển thị thành công
@enduml

