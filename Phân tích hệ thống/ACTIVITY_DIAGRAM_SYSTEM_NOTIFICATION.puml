@startuml Activity Diagram - Notification Automation (UC70, UC70A, UC70B)
!theme plain
title Activity Diagram - Notification Automation (UC70, UC70A, UC70B)

|System|
start
if (Thông báo đặt phòng?) then
    :Gửi thông báo đặt phòng;
    :Trigger: Booking mới hoặc booking được cập nhật;
    :Lấy thông tin booking;
    :Tạo notification record (type = booking, priority = high);
    :Lấy danh sách Staff/Admin online;
    :Lưu vào database;
    :Phát event 'notification:new' qua Socket.IO;
    :Broadcast đến Staff/Admin rooms;
elseif (Thông báo payment?) then
    :Thông báo payment;
    :Trigger: Payment thành công/thất bại/hoàn tiền;
    :Lấy thông tin payment và booking;
    :Tạo notification record (type = payment);
    :Lưu vào database;
    :Phát event 'notification:new' qua Socket.IO;
    :Broadcast đến relevant users;
elseif (Thông báo đặt đoàn?) then
    :Thông báo đặt đoàn;
    :Trigger: Group booking request/approved/quoted/paid;
    :Lấy thông tin group booking;
    :Lấy danh sách Staff/Admin online;
    :Tạo notification record (type = group_booking);
    :Lưu vào database;
    :Phát event 'notification:new' qua Socket.IO;
    :Broadcast đến Staff/Admin rooms;
endif
stop
@enduml
