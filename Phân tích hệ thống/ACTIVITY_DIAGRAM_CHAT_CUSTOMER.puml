@startuml Activity Diagram - Chat với staff/admin (Customer) - UC49
!theme plain
title Activity Diagram - Chat với staff/admin (Customer) - UC49

|Customer|
start
:Mở chat;
|System|
:Kiểm tra đã có conversation?;
if (Chưa có?) then (có)
    :Tìm staff active;
    if (Có staff online?) then (có)
        :Gán staff;
    else
        if (Fallback admin = true?) then (có)
            :Gán admin (nếu online);
        endif
        :Conversation status = waiting;
    endif
    :Tạo conversation mới;
    |Socket.IO|
    :Gửi thông báo realtime;
endif
|Customer|
:Kết nối Socket.IO;
:Join room theo conversationId;
:Hiển thị conversation;
stop
@enduml
