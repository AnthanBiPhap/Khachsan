elseif (Sửa loại phòng?) then
    :Sửa loại phòng;
    :Cập nhật thông tin;
    |System|
    :Kiểm tra có phòng đang sử dụng?;
    :Lưu thay đổi;
elseif (Xóa loại phòng?) then
    :Xóa loại phòng;
    :Xác nhận xóa;
    |System|
    :Kiểm tra có phòng đang sử dụng?;
    if (Có phòng?) then (có)
        |Admin|
        :Hiển thị lỗi;
        stop
    endif
    :Xóa mềm (soft delete);
endif
|Admin|
:Thành công;
stop
