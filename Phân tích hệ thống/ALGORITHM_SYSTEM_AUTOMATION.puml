@startuml Algorithm - Cập nhật trạng thái tự động
!theme plain
title Sơ đồ thuật toán - Cập nhật trạng thái tự động

start
:Input: scheduled job trigger;
:Lấy bookings với status đang chờ xử lý;
foreach (Booking) do
 if (Giữ chỗ hết hạn?) then (Có)
 :Cập nhật status = 'expired';
 :Giải phóng phòng;
 endif
 if (No-show?) then (Có)
 :Cập nhật status = 'no_show';
 :Giải phóng phòng;
 endif
 if (Checkout quá hạn?) then (Có)
 :Cập nhật status = 'overdue_checkout';
 :Tính phí phụ thu;
 endif
 :Lưu vào database;
end
:Cập nhật trạng thái phòng theo booking;
:Return SUCCESS;
stop
@enduml

