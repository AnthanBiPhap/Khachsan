@startuml Activity Diagram - Quản lý Phòng (Admin) - UC13, UC15
!theme plain
title Activity Diagram - Quản lý Phòng (Admin) - UC13, UC15

|Admin|
start
if (Tạo phòng?) then
    :Tạo phòng mới;
    :Điền thông tin phòng;
    |System|
    :Kiểm tra số phòng tồn tại?;
    if (Đã tồn tại?) then (có)
        |Admin|
        :Hiển thị lỗi;
        stop
    endif
    :Tạo phòng (status = available);
    :Lưu vào database;
elseif (Sửa phòng?) then
    :Sửa phòng;
    :Cập nhật thông tin;
    |System|
    :Lưu thay đổi;
elseif (Xóa phòng?) then
    :Xóa phòng;
    :Xác nhận xóa;
    |System|
    :Kiểm tra có booking active?;
    if (Có booking?) then (có)
        |Admin|
        :Hiển thị lỗi;
        stop
    endif
    :Xóa mềm (soft delete);
elseif (Cập nhật trạng thái?) then
    :Cập nhật trạng thái phòng;
    :Chọn trạng thái mới;
    |System|
    :Cập nhật status;
    :Cập nhật availability;
endif
|Admin|
:Thành công;
stop
@enduml
