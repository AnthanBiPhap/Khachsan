@startuml Algorithm - Phân quyền RBAC
!theme plain
title Sơ đồ thuật toán - Phân quyền RBAC

start
partition "Kiểm tra quyền" {
 :Input: JWT token, resource, action;
 :Verify token;
 :Lấy userRole từ token;
 :Kiểm tra status user;
 if (userRole == 'admin') then (Có)
 :hasPermission = true;
 else
 :Kiểm tra quyền theo role;
 :hasPermission = checkPermission(role, resource, action);
 endif
 if (Không có quyền?) then (Có)
 :Return ERROR;
 stop
 endif
 :Return SUCCESS;
}

partition "Gán vai trò" {
 :Input: adminId, targetUserId, newRole;
 :Kiểm tra quyền Admin;
 :Validate role;
 :Cập nhật role;
 :Xóa sessions cũ;
 :Ghi audit log;
 :Return SUCCESS;
}
stop
@enduml

