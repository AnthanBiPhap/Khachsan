@startuml Algorithm - Realtime notifications
!theme plain
title Sơ đồ thuật toán - Realtime notifications

start
:Input: socket connection, userId;
:Xác thực JWT token;
:Join Socket.IO room theo userId;
:Listen event 'notification:new';
if (Nhận event 'notification:new'?) then (Có)
 :Hiển thị notification ngay;
 :Tự động tăng unreadCount;
 :Cập nhật badge;
 :Trigger sound/browser notification (nếu cấu hình);
endif
if (Mất kết nối?) then (Có)
 :Kích hoạt polling fallback;
 :Poll API mỗi 30-60 giây;
 :Khi kết nối lại → đồng bộ lại;
endif
stop
@enduml

