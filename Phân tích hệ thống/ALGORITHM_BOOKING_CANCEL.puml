@startuml Algorithm - Hủy đặt phòng (UC19, UC19A)
!theme plain
title Sơ đồ thuật toán - Hủy đặt phòng (UC19, UC19A)

start
:Input: bookingId, reason;
if (Role = Customer?) then (Có)
 :Kiểm tra chính sách hủy;
 :Tạo yêu cầu hủy (status = cancellation_requested);
 :Gửi thông báo cho Staff/Admin;
else
 :Kiểm tra chính sách hủy;
 if (Phê duyệt hủy?) then (Có)
 :Cập nhật status = cancelled;
 :Giải phóng phòng;
 :Tính tiền hoàn lại (nếu có);
 :Xử lý hoàn tiền;
 :Ghi audit log;
 else
 :Từ chối hủy;
 endif
endif
:Return SUCCESS;
stop
@enduml

