@startuml Activity Diagram - Xử lý thanh toán Stripe 
!theme plain
title Activity Diagram - Xử lý thanh toán Stripe 

|System|
start
if (Tạo checkout?) then
    :Xử lý thanh toán Stripe;
    :Tạo Stripe Checkout Session;
    :Set idempotency key;
    :Thiết lập thông tin session (amount, currency, bookingId, paymentId);
    :Lưu session vào database;
    :Trả về checkout URL;
elseif (Webhook từ Stripe?) then
    :Nhận Stripe webhook event;
    :Xác minh HMAC signature;
    if (Invalid signature?) then (có)
        :Reject webhook;
        stop
    endif
    :Kiểm tra idempotency (tránh duplicate);
    if (Đã xử lý?) then (có)
        :Return 200 (idempotent);
        stop
    endif
    :Cập nhật payment status;
    :Cập nhật booking payment status;
    :Tạo invoice (nếu cần);
    :Lưu vào database;
    :Gửi email xác nhận thanh toán (async);
    :Gửi hóa đơn (async);
    :Return 200;
endif
stop
@enduml
