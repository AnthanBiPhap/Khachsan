@startuml UC70B_GroupBookingNotification
!theme plain
title UC70B: Thông báo đặt đoàn

actor System
participant "Backend Service" as Service
participant "Socket.IO" as Socket
database "Database" as DB

System -> Service: Event: Group booking event\n(groupBookingId, event: requested/approved/quoted/paid)

alt Event: Yêu cầu đặt đoàn
    Service -> DB: Tạo notification\n(type: new_group_booking, recipients: admin/staff)
    Service -> Socket: Emit "new_group_booking"\n(group booking data)
    Socket --> Frontend: Real-time notification\n(admin/staff)
else Event: Duyệt đặt đoàn
    Service -> DB: Tạo notification\n(type: group_booking_approved, recipients: customer)
    Service -> Socket: Emit "group_booking_approved"\n(group booking data)
    Socket --> Frontend: Real-time notification\n(customer)
else Event: Báo giá
    Service -> DB: Tạo notification\n(type: group_booking_quoted, recipients: customer)
    Service -> Socket: Emit "group_booking_quoted"\n(quote data)
    Socket --> Frontend: Real-time notification\n(customer)
else Event: Thanh toán
    Service -> DB: Tạo notification\n(type: group_booking_paid, recipients: customer + admin/staff)
    Service -> Socket: Emit "group_booking_paid"\n(payment data)
    Socket --> Frontend: Real-time notification\n(all recipients)
end

Service -> DB: Cập nhật badge unread count
DB --> Service: Updated

Frontend -> Frontend: Update UI\n(badge, notification list)
Frontend --> User: Hiển thị notification
@enduml

