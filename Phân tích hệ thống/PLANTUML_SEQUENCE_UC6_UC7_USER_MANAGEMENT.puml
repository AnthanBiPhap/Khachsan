@startuml UC6_UC7_UserManagement
!theme plain
title UC6-UC7: Quản lý người dùng (Users)

actor Admin
participant "Admin Frontend" as Frontend
participant "Backend API" as API
database "Database" as DB
participant "Email Service" as Email

' ========== VIEW USERS ==========
Admin -> Frontend: Truy cập trang "Quản lý người dùng"
Frontend -> API: GET /api/v1/users\n(Authorization: Bearer token)\n(query params: page, limit, fullName, sort_by, sort_type)

API -> API: Verify JWT + Check role = admin
API -> DB: Query users\n(filter: deletedAt = null)\n(filter by fullName nếu có)\n(sort, pagination)

DB --> API: Users list

API --> Frontend: Success + users list + pagination
Frontend --> Admin: Hiển thị danh sách users\n(role, status, createdAt)

' ========== CREATE USER ==========
Admin -> Frontend: Click "Tạo mới"
Admin -> Frontend: Nhập thông tin\n(fullName, email, phoneNumber, password, role, status, preferences)
Admin -> Frontend: Submit

Frontend -> API: POST /api/v1/users\n(Authorization: Bearer token)\n{ fullName, email, phoneNumber, password, role, status, preferences }

API -> API: Verify JWT + Check role = admin
API -> DB: Kiểm tra email đã tồn tại?\n(filter: email, deletedAt = null)

alt Email đã tồn tại
    DB --> API: Email exists
    API --> Frontend: Error: "Email đã được sử dụng"
    Frontend --> Admin: Hiển thị lỗi
else Email chưa tồn tại
    DB --> API: Email not found
    API -> DB: Kiểm tra phoneNumber đã tồn tại?\n(filter: phoneNumber, deletedAt = null)
    
    alt PhoneNumber đã tồn tại
        DB --> API: Phone exists
        API --> Frontend: Error: "Số điện thoại đã được sử dụng"
        Frontend --> Admin: Hiển thị lỗi
    else PhoneNumber chưa tồn tại
        DB --> API: Phone not found
        
        API -> API: Tạo email verification token\n(nếu role = customer)
        API -> API: Hash password
        API -> DB: Tạo user mới\n(emailVerified = true nếu admin/staff)
        DB --> API: User created
        
        alt Role = customer
            API -> Email: Gửi email xác nhận\n(verification token)
            Email --> Admin: Email xác nhận đã gửi
        end
        
        API --> Frontend: Success: "Đã tạo user thành công"
        Frontend --> Admin: Hiển thị thông báo thành công
    end
end

' ========== UPDATE USER ==========
Admin -> Frontend: Chọn user cần sửa
Admin -> Frontend: Click "Sửa"
Admin -> Frontend: Cập nhật thông tin\n(fullName, email, phoneNumber, password, role, status, preferences)
Admin -> Frontend: Submit

Frontend -> API: PUT /api/v1/users/:id\n(Authorization: Bearer token)\n{ updated fields }

API -> API: Verify JWT + Check role = admin
API -> DB: Tìm user theo ID\n(filter: deletedAt = null)
DB --> API: User found

API -> DB: Kiểm tra email trùng?\n(filter: email, _id != id, deletedAt = null)

alt Email trùng với user khác
    DB --> API: Email exists
    API --> Frontend: Error: "Email đã được sử dụng"
    Frontend --> Admin: Hiển thị lỗi
else Email không trùng
    DB --> API: Email not found
    API -> DB: Kiểm tra phoneNumber trùng?\n(filter: phoneNumber, _id != id, deletedAt = null)
    
    alt PhoneNumber trùng
        DB --> API: Phone exists
        API --> Frontend: Error: "Số điện thoại đã được sử dụng"
        Frontend --> Admin: Hiển thị lỗi
    else PhoneNumber không trùng
        DB --> API: Phone not found
        
        API -> API: Hash password mới (nếu có)
        API -> DB: Cập nhật user
        DB --> API: User updated
        
        API --> Frontend: Success: "Đã cập nhật user thành công"
        Frontend --> Admin: Hiển thị thông báo thành công
    end
end

' ========== BLOCK/UNBLOCK USER (UC7) ==========
Admin -> Frontend: Chọn user cần khóa/mở khóa
Admin -> Frontend: Click "Khóa" / "Mở khóa"
Frontend -> API: PUT /api/v1/users/:id\n(Authorization: Bearer token)\n{ status: "blocked" / "active" }

API -> API: Verify JWT + Check role = admin
API -> DB: Tìm user theo ID
DB --> API: User found

API -> DB: Cập nhật status\n(status = blocked/active)
DB --> API: User updated

API --> Frontend: Success: "Đã cập nhật trạng thái user"
Frontend --> Admin: Hiển thị thông báo thành công\n(user bị chặn truy cập nếu blocked)

' ========== DELETE USER (SOFT DELETE) ==========
Admin -> Frontend: Chọn user cần xóa
Admin -> Frontend: Click "Xóa"
Frontend -> API: DELETE /api/v1/users/:id\n(Authorization: Bearer token)

API -> API: Verify JWT + Check role = admin
API -> DB: Tìm user theo ID\n(filter: deletedAt = null)
DB --> API: User found

API -> DB: Soft delete user\n(set deletedAt = now())
DB --> API: User deleted (soft)

API --> Frontend: Success: "Đã xóa user thành công (soft delete)"
Frontend --> Admin: Hiển thị thông báo thành công\n(chuyển đến trang deleted users)

' ========== VIEW DELETED USERS ==========
Admin -> Frontend: Truy cập trang "Users đã xóa"
Frontend -> API: GET /api/v1/users/deleted\n(Authorization: Bearer token)\n(query params: page, limit, fullName)

API -> API: Verify JWT + Check role = admin
API -> DB: Query users\n(filter: deletedAt != null)\n(filter by fullName nếu có)\n(sort, pagination)

DB --> API: Deleted users list

API --> Frontend: Success + deleted users list + pagination
Frontend --> Admin: Hiển thị danh sách users đã xóa\n(deletedAt, có thể khôi phục)

' ========== RESTORE USER ==========
Admin -> Frontend: Chọn user đã xóa cần khôi phục
Admin -> Frontend: Click "Khôi phục"
Frontend -> API: PUT /api/v1/users/:id/restore\n(Authorization: Bearer token)

API -> API: Verify JWT + Check role = admin
API -> DB: Tìm user theo ID\n(filter: deletedAt != null)
DB --> API: User found

API -> DB: Khôi phục user\n(set deletedAt = null)
DB --> API: User restored

API --> Frontend: Success: "Đã khôi phục user thành công"
Frontend --> Admin: Hiển thị thông báo thành công
@enduml

