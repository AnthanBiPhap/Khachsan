@startuml Algorithm_Import_Export_Customer
!theme plain

skinparam defaultFontSize 14
skinparam activityFontSize 14
skinparam noteFontSize 14
skinparam arrowFontSize 14

start
:Input: action, excelFile, bookingId;

:Validate action;

if (action = "importThanhVien"?) then (có)
    :Đọc file Excel danh sách thành viên;
    :Validate dữ liệu;
    if (Dữ liệu hợp lệ?) then (có)
        :Lưu thông tin thành viên vào group booking;
        :Lưu vào database;
        :result = "SUCCESS";
    else (không)
        :result = "ERROR - Dữ liệu không hợp lệ";
    endif
elseif (action = "exportThanhVien"?) then (có)
    :Lấy danh sách thành viên từ group booking;
    :Tạo file Excel;
    :result = "SUCCESS";
else (không)
    :result = "ERROR - Action không hợp lệ";
endif

:Return result;

stop

@enduml

