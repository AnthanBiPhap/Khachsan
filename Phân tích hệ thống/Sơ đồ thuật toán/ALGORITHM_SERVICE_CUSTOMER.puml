@startuml Algorithm_Service_Customer
!theme plain

skinparam defaultFontSize 14
skinparam activityFontSize 14
skinparam noteFontSize 14
skinparam arrowFontSize 14

start
:Input: action, serviceId, bookingId;

:Validate action;

if (action = "datDichVu"?) then (có)
    :Tìm booking theo bookingId;
    :Tạo service booking;
    :Tính toán chi phí dịch vụ;
    :Đồng bộ chi phí vào invoice;
    :Lưu vào database;
    :result = "SUCCESS";
elseif (action = "xemDanhSach"?) then (có)
    :Lấy danh sách dịch vụ với bộ lọc;
    :result = "SUCCESS";
else (không)
    :result = "ERROR - Action không hợp lệ";
endif

:Return result;

stop

@enduml

