@startuml Algorithm_Chat_Customer
!theme plain

skinparam defaultFontSize 14
skinparam activityFontSize 14
skinparam noteFontSize 14
skinparam arrowFontSize 14

start
:Input: action, message, file;

:Validate action;

if (action = "guiTinNhan"?) then (có)
    :Tự động ghép với staff online;
    :Lưu tin nhắn vào database;
    :Phát sự kiện qua Socket.IO;
    :result = "SUCCESS";
elseif (action = "xemLichSu"?) then (có)
    :Lấy lịch sử chat với phân trang;
    :result = "SUCCESS";
else (không)
    :result = "ERROR - Action không hợp lệ";
endif

:Return result;

stop

@enduml

