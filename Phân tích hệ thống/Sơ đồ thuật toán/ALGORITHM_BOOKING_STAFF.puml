@startuml Algorithm_Booking_Staff
!theme plain

skinparam defaultFontSize 14
skinparam activityFontSize 14
skinparam noteFontSize 14
skinparam arrowFontSize 14

start
:Input: action, bookingId, status;

:Validate action;

if (action = "capNhatTrangThai"?) then (có)
    :Tìm booking theo bookingId;
    :Kiểm tra quyền thay đổi trạng thái;
    :Cập nhật booking status\n(pending, confirmed, checked_in, checked_out, cancelled);
    :Lưu vào database;
    :result = "SUCCESS";
elseif (action = "checkIn"?) then (có)
    :Tìm booking theo bookingId;
    :Kiểm tra điều kiện check-in;
    :Cập nhật thời gian check-in;
    :Cập nhật trạng thái checked_in;
    :Lưu vào database;
    :result = "SUCCESS";
else (không)
    :result = "ERROR - Action không hợp lệ";
endif

:Return result;

stop

@enduml

