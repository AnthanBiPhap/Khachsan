@startuml Algorithm_Dashboard_Admin
!theme plain

skinparam defaultFontSize 14
skinparam activityFontSize 14
skinparam noteFontSize 14
skinparam arrowFontSize 14

start
:Input: action, filters, dateRange;

:Validate action;

if (action = "xemDashboard"?) then (có)
    :Lấy dữ liệu thống kê\n(đặt phòng, công suất, doanh thu, tỷ lệ hủy);
    :Tính toán biểu đồ xu hướng;
    :result = "SUCCESS";
elseif (action = "xemBaoCao"?) then (có)
    :Lấy dữ liệu báo cáo với bộ lọc\n(ngày/tuần/tháng, loại phòng, kênh, trạng thái);
    :result = "SUCCESS";
else (không)
    :result = "ERROR - Action không hợp lệ";
endif

:Return result;

stop

@enduml

