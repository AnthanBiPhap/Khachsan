@startuml Algorithm_Booking_Admin
!theme plain

skinparam defaultFontSize 14
skinparam activityFontSize 14
skinparam noteFontSize 14
skinparam arrowFontSize 14

start
:Input: action, bookingId, checkInTime, checkOutTime;

:Validate action;

if (action = "checkIn"?) then (có)
    :Tìm booking theo bookingId;
    :Kiểm tra điều kiện check-in;
    :Cập nhật thời gian check-in;
    :Cập nhật trạng thái checked_in;
    :Lưu vào database;
    :result = "SUCCESS";
elseif (action = "checkOut"?) then (có)
    :Tìm booking theo bookingId;
    :Kiểm tra điều kiện check-out;
    :Cập nhật thời gian check-out;
    :Cập nhật trạng thái checked_out;
    :Lưu vào database;
    :result = "SUCCESS";
else (không)
    :result = "ERROR - Action không hợp lệ";
endif

:Return result;

stop

@enduml

