@startuml Algorithm_Room_Customer
!theme plain

skinparam defaultFontSize 14
skinparam activityFontSize 14
skinparam noteFontSize 14
skinparam arrowFontSize 14

start
:Input: action, filters, checkIn, checkOut,\nguests, roomType, priceRange,\nroomId;

:Validate action;

if (action = "xemDanhSach"?) then (có)
    :Lấy danh sách phòng\náp dụng bộ lọc loại phòng, giá, tiện nghi;
    :result = "SUCCESS - Danh sách phòng";
elseif (action = "timKiem"?) then (có)
    :Kiểm tra tính khả dụng phòng\ndựa trên bookings hiện có;
    :Lọc phòng còn trống trong khoảng thời gian;
    :Lọc theo số lượng khách, loại phòng, khoảng giá;
    :result = "SUCCESS - Danh sách phòng khả dụng";
elseif (action = "xemChiTiet"?) then (có)
    :Lấy thông tin phòng\npopulate loại phòng;
    :Lấy mô tả, tiện nghi, hình ảnh, giá\ntừ loại phòng;
    :result = "SUCCESS - Chi tiết phòng";
else (không)
    :result = "ERROR - Action không hợp lệ";
endif

:Return result;

stop

@enduml

