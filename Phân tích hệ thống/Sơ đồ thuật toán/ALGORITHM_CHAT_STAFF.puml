@startuml Algorithm_Chat_Staff
!theme plain

skinparam defaultFontSize 14
skinparam activityFontSize 14
skinparam noteFontSize 14
skinparam arrowFontSize 14

start
:Input: action, message, file, conversationId;

:Validate action;

if (action = "guiTinNhan"?) then (có)
    :Lưu tin nhắn vào database;
    :Phát sự kiện qua Socket.IO;
    :result = "SUCCESS";
elseif (action = "danhDauDaDoc"?) then (có)
    :Cập nhật trạng thái đã đọc;
    :Cập nhật số tin nhắn chưa đọc;
    :Lưu vào database;
    :result = "SUCCESS";
else (không)
    :result = "ERROR - Action không hợp lệ";
endif

:Return result;

stop

@enduml

