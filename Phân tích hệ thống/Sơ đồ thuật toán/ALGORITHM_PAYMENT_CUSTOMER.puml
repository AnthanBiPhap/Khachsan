@startuml Algorithm_Payment_Customer
!theme plain

skinparam defaultFontSize 14
skinparam activityFontSize 14
skinparam noteFontSize 14
skinparam arrowFontSize 14

start
:Input: action, bookingId, amount;

:Validate action;

if (action = "thanhToanOnline"?) then (có)
    :Tạo Stripe checkout session;
    :Redirect đến trang thanh toán Stripe;
    :Xử lý webhook từ Stripe;
    if (Thanh toán thành công?) then (có)
        :Tạo booking, invoice và payment record;
        :Lưu vào database;
        :result = "SUCCESS";
    else (không)
        :result = "ERROR - Thanh toán thất bại";
    endif
elseif (action = "xemHoaDon"?) then (có)
    :Lấy thông tin invoice theo bookingId;
    :result = "SUCCESS";
else (không)
    :result = "ERROR - Action không hợp lệ";
endif

:Return result;

stop

@enduml

