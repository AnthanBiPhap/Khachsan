@startuml Algorithm_Location_Customer
!theme plain

skinparam defaultFontSize 14
skinparam activityFontSize 14
skinparam noteFontSize 14
skinparam arrowFontSize 14

start
:Input: action, locationId, filters;

:Validate action;

if (action = "xemDanhSach"?) then (có)
    :Lấy danh sách địa điểm với bộ lọc;
    :result = "SUCCESS";
elseif (action = "xemChiTiet"?) then (có)
    :Lấy thông tin chi tiết địa điểm\n(mô tả, hình ảnh, vị trí, thời gian mở cửa);
    :result = "SUCCESS";
else (không)
    :result = "ERROR - Action không hợp lệ";
endif

:Return result;

stop

@enduml

