@startuml Algorithm_Service_Staff
!theme plain

skinparam defaultFontSize 14
skinparam activityFontSize 14
skinparam noteFontSize 14
skinparam arrowFontSize 14

start
:Input: action, serviceBookingId, status;

:Validate action;

if (action = "capNhatTrangThai"?) then (có)
    :Tìm service booking theo ID;
    :Kiểm tra quyền thay đổi trạng thái;
    :Cập nhật trạng thái service booking;
    :Đồng bộ chi phí vào invoice;
    :Lưu vào database;
    :result = "SUCCESS";
else (không)
    :result = "ERROR - Action không hợp lệ";
endif

:Return result;

stop

@enduml

