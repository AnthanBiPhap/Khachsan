@startuml Algorithm_Import_Export_Admin
!theme plain

skinparam defaultFontSize 14
skinparam activityFontSize 14
skinparam noteFontSize 14
skinparam arrowFontSize 14

start
:Input: action, excelFile, filters, format;

:Validate action;

if (action = "exportBaoCao"?) then (có)
    :Lấy dữ liệu báo cáo với bộ lọc;
    if (format = "Excel"?) then (có)
        :Tạo file Excel;
    else (không)
        :Tạo file PDF;
    endif
    :result = "SUCCESS";
elseif (action = "importKhachHang"?) then (có)
    :Đọc file Excel danh sách khách hàng;
    :Validate dữ liệu;
    if (Dữ liệu hợp lệ?) then (có)
        :Lưu thông tin khách hàng vào database;
        :result = "SUCCESS";
    else (không)
        :result = "ERROR - Dữ liệu không hợp lệ";
    endif
else (không)
    :result = "ERROR - Action không hợp lệ";
endif

:Return result;

stop

@enduml

