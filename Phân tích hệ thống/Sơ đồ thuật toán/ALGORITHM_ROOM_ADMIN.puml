@startuml Algorithm_Room_Admin
!theme plain

skinparam defaultFontSize 14
skinparam activityFontSize 14
skinparam noteFontSize 14
skinparam arrowFontSize 14

start
:Input: action, roomData, roomId;

:Validate action;

if (action = "taoPhong"?) then (có)
    :Kiểm tra roomNumber đã tồn tại?;
    if (Đã tồn tại?) then (có)
        :result = "ERROR - Số phòng đã tồn tại";
    else (không)
        :Tạo phòng mới;
        :Lưu vào database;
        :result = "SUCCESS";
    endif
elseif (action = "suaPhong"?) then (có)
    :Cập nhật thông tin phòng;
    :Lưu vào database;
    :result = "SUCCESS";
else (không)
    :result = "ERROR - Action không hợp lệ";
endif

:Return result;

stop

@enduml

