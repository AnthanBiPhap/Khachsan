@startuml Algorithm_Booking_Customer
!theme plain

skinparam defaultFontSize 14
skinparam activityFontSize 14
skinparam noteFontSize 14
skinparam arrowFontSize 14

start
:Input: action, roomId, checkIn, checkOut, guests;

:Validate action;

if (action = "datPhongCaNhan"?) then (có)
    :Kiểm tra tính khả dụng phòng;
    if (Phòng không khả dụng?) then (có)
        :result = "ERROR - Phòng không khả dụng";
    else (không)
        :Tính toán tổng giá;
        :Tạo booking;
        :Lưu vào database;
        :result = "SUCCESS";
    endif
elseif (action = "xemDanhSach"?) then (có)
    :Lấy danh sách booking của user;
    :result = "SUCCESS";
else (không)
    :result = "ERROR - Action không hợp lệ";
endif

:Return result;

stop

@enduml

