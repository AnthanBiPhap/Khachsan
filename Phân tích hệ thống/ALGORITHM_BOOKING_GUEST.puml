@startuml Algorithm - Quản lý thông tin khách
!theme plain
title Sơ đồ thuật toán - Quản lý thông tin khách

start
:Input: action (create/update/delete), guestData, bookingId;
if (action == 'create') then (Tạo)
 :Tạo guest record;
 :Liên kết với booking;
elseif (action == 'update') then (Sửa)
 :Lưu thông tin cũ (lịch sử);
 :Cập nhật thông tin mới;
elseif (action == 'delete') then (Xóa)
 :Kiểm tra booking đã check-in?;
 :Xóa khách đi kèm;
endif
:Lưu vào database;
:Ghi audit log;
:Return SUCCESS;
stop
@enduml

