@startuml Algorithm - Quản lý conversation (UC53, UC53C)
!theme plain
title Sơ đồ thuật toán - Quản lý conversation (UC53, UC53C)

start
if (Tham gia conversation?) then
 :Input: conversationId, staffId;
 :Kiểm tra conversation chưa được gán?;
 if (Chưa được gán?) then (Có)
 :Gán staff/admin cho conversation;
 :Cập nhật status = active;
 endif
 :Join Socket.IO room;
elseif (Gắn với booking?) then
 :Input: bookingId, staffId;
 :Lấy customerId từ booking;
 :Kiểm tra đã có conversation?;
 if (Chưa có?) then (Có)
 :Tạo conversation mới;
 endif
 :Gắn bookingId vào conversation;
 :Lưu booking context;
 :Gửi thông báo cho customer;
endif
:Return SUCCESS;
stop
@enduml

