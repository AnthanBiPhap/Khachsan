@startuml Algorithm - Guests Management (Tổng hợp)
!theme plain
title Sơ đồ thuật toán - Guests Management (Tổng hợp)

start
:Input: action, guestId, bookingId, data, filters;
:Validate action;
:Kiểm tra quyền Staff/Admin (trừ view);
if (action = "list"?) then (Có)
    :Gọi thuật toán Xem danh sách khách;
    :Input: filters, pagination;
    :Lấy guests từ DB;
    :Áp dụng filters;
    :Return: danh sách guests;
elseif (action = "detail"?) then (Có)
    :Gọi thuật toán Xem chi tiết khách;
    :Input: guestId;
    :Lấy chi tiết guest;
    :Lấy booking history;
    :Return: guest detail;
elseif (action = "create" hoặc "update"?) then (Có)
    :Kiểm tra quyền Staff/Admin;
    :Gọi thuật toán Tạo/Sửa khách;
    :Input: guestData, operation;
    :Validate guest data;
    :Kiểm tra email/SĐT trùng lặp?;
    :Lưu vào DB;
    :Return: guestId / ERROR;
elseif (action = "delete" hoặc "restore"?) then (Có)
    :Kiểm tra quyền Admin;
    :Gọi thuật toán Xóa/Khôi phục;
    :Input: guestId, operation;
    :Kiểm tra có bookings active?;
    :Xóa mềm hoặc restore;
    :Return: SUCCESS / ERROR;
elseif (action = "bookingHistory"?) then (Có)
    :Gọi thuật toán Lịch sử booking;
    :Input: guestId, filters;
    :Lấy lịch sử bookings;
    :Lấy service bookings;
    :Return: booking history;
endif
:Return result;
stop
@enduml

